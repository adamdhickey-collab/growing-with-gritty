---
import '@fontsource-variable/fredoka';
import '@fontsource-variable/nunito';
/* Patrick Hand — Gritty's speech bubbles only. One font, one job. */
import '@fontsource/patrick-hand';
import '../styles/tokens.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

/* Imported for their hashed build URLs so the two above-the-fold faces can be
   preloaded — otherwise the first visit flashes fallback before the rounded
   lettering arrives, on a site whose identity is mostly its lettering. */
import fredokaUrl from '@fontsource-variable/fredoka/files/fredoka-latin-wght-normal.woff2?url';
import nunitoUrl from '@fontsource-variable/nunito/files/nunito-latin-wght-normal.woff2?url';
import { indexable } from '../../site.config.mjs';
import { u } from '../lib/url';

interface Props {
  title: string;
  description: string;
  /* Page-specific share image (an absolute site path, e.g. a book cover).
     Falls back to the site-wide card. Crawlers and chat apps want a real
     raster at a known size, so these are JPEG rather than the WebP the
     pages themselves use. */
  image?: string;
  /* Schema.org JSON-LD for this page. Search engines and AI assistants read
     it to learn what the page *is* — a book, a person, a site — rather than
     inferring it from prose. Passed as a plain object; serialised below. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /* Keep this one page out of search even when the site is indexable.
     A meta tag, not a robots.txt rule: robots.txt stops the fetch, which
     also stops the crawler ever reading this tag, and a blocked page can
     still be listed from links alone. */
  noindex?: boolean;
}
const { title, description, image, jsonLd, noindex = false } = Astro.props;
const hidden = !indexable || noindex;
const canonical = new URL(Astro.url.pathname, Astro.site);
const shareImage = new URL(u(image ?? '/share-card.jpg'), Astro.site);
/* set only by the GitHub Pages review build */
const tiles = import.meta.env.PUBLIC_TILES_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Warm paper is the identity — declaring light stops a dark-mode OS
        force-darkening what few native controls there are. */}
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#FAF6EC" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={u("/icon.png")} type="image/png" />
    <link rel="apple-touch-icon" href={u("/apple-touch-icon.png")} />
    <link rel="canonical" href={canonical} />
    {/* Site-wide: the switch in site.config.mjs, flipped there and never by
        hand here. Per page: the `noindex` prop, for the handful of pages
        that are ours rather than the public's. */}
    {hidden && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Growing with Gritty" />
    <meta property="og:locale" content="en_US" />
    {/* Kim is emailing this link to colleagues and families, so the preview
        card is the first thing many people will see of the site. */}
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Gritty the Goat, from the Growing with Gritty books by Kim Rekowski" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />
    {jsonLd && (
      <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify(jsonLd)}
      />
    )}

    <link rel="preload" href={fredokaUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={nunitoUrl} as="font" type="font/woff2" crossorigin />
    {/* The "Pause animations" choice (MotionToggle.astro), restored before
        the first paint so a paused meadow never twitches on the way in. */}
    <script is:inline>
      try {
        if (localStorage.getItem('gg-motion') === 'calm') document.documentElement.dataset.motion = 'calm';
      } catch (e) { /* storage blocked — the page simply starts in motion */ }
    </script>
    {tiles && <style is:global>
      /* version switcher — identical to the one on the style tiles */
      .tile-switch { position: sticky; top: 0; z-index: 300; display: flex; flex-wrap: wrap;
        align-items: center; justify-content: center; gap: 6px 14px; padding: 9px 16px;
        background: #1F4666; color: #fff; font-family: "Nunito", "Trebuchet MS", sans-serif;
        box-shadow: 0 2px 10px -4px rgba(0,0,0,.4); }
      .ts-label { font-size: .72rem; font-weight: 800; letter-spacing: .14em;
        text-transform: uppercase; color: #BDD7E7; }
      .ts-group { display: flex; flex-wrap: wrap; gap: 6px; justify-content: center; }
      .ts-opt { display: flex; align-items: baseline; gap: 6px; padding: 7px 14px;
        border-radius: 999px; min-height: 40px; text-decoration: none; color: #fff;
        background: rgba(255,255,255,.14); font-family: "Fredoka", "Comic Sans MS", cursive;
        font-weight: 600; transition: background .15s ease, translate .15s ease; }
      .ts-opt b { font-size: .95rem; }
      .ts-opt i { font-style: normal; font-size: .82rem; opacity: .8; font-weight: 400; }
      .ts-opt:hover { background: rgba(255,255,255,.3); color: #fff; translate: 0 -1px; }
      .ts-opt:focus-visible { outline: 3px solid #D9A93F; outline-offset: 2px; }
      .ts-opt[aria-current="page"] { background: #fff; color: #1F4666; cursor: default;
        box-shadow: 0 3px 10px -4px rgba(0,0,0,.45); }
      .ts-opt[aria-current="page"] i { opacity: .68; }
      .ts-opt[aria-current="page"]::before { content: "●"; font-size: .55rem; color: #7FA86B; }
      @media (max-width: 600px) { .ts-label { width: 100%; text-align: center; }
        .ts-opt i { display: none; } }
    </style>}
  </head>
  <body>
    <a class="visually-hidden" href="#main">Skip to content</a>
    {/* The one live region every game announces through — see
        src/lib/announce.ts for why it lives here and not on each cheer. */}
    <div class="visually-hidden" role="status" aria-live="polite" data-announcer></div>
    {/* Review-build only: the same switcher the style tiles carry, so the
        three design directions and the real site all link together. Absent
        from the production build. */}
    {tiles && (
      <nav class="tile-switch" aria-label="Style tile versions">
        <span class="ts-label">Style tile</span>
        <div class="ts-group">
          <a class="ts-opt" href={`${tiles}/`}><b>V1</b> <i>The Sheet</i></a>
          <a class="ts-opt" href={`${tiles}/v2/`}><b>V2</b> <i>The Meadow</i></a>
          <a class="ts-opt" href={`${tiles}/v3/`}><b>V3</b> <i>Alive</i></a>
          <a class="ts-opt" aria-current="page"><b>The Site</b> <i>real pages</i></a>
        </div>
      </nav>
    )}
    <Header />
    {/* tabindex -1 so the skip link actually moves focus here. */}
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
