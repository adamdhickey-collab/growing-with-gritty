---
import '@fontsource-variable/fredoka';
import '@fontsource-variable/nunito';
/* Patrick Hand — Gritty's speech bubbles only. One font, one job. */
import '@fontsource/patrick-hand';
import '../styles/tokens.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

/* Imported for their hashed build URLs so the two above-the-fold faces can be
   preloaded — otherwise the first visit flashes fallback before the rounded
   lettering arrives, on a site whose identity is mostly its lettering. */
import fredokaUrl from '@fontsource-variable/fredoka/files/fredoka-latin-wght-normal.woff2?url';
import nunitoUrl from '@fontsource-variable/nunito/files/nunito-latin-wght-normal.woff2?url';
import { indexable } from '../../site.config.mjs';

interface Props { title: string; description: string }
const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Warm paper is the identity — declaring light stops a dark-mode OS
        force-darkening what few native controls there are. */}
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#FAF6EC" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/icon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />
    {/* The switch that keeps the site out of search while it's being built —
        flipped by site.config.mjs, never by hand here. */}
    {!indexable && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />

    <link rel="preload" href={fredokaUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={nunitoUrl} as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a class="visually-hidden" href="#main">Skip to content</a>
    <Header />
    {/* tabindex -1 so the skip link actually moves focus here. */}
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
