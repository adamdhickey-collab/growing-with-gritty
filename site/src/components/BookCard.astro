---
import type { CollectionEntry } from 'astro:content';
import { u } from '../lib/url';
import { buyLabel } from '../lib/buy';
import IconCart from './IconCart.astro';

interface Props { book: CollectionEntry<'books'>; headingLevel?: 2 | 3 }
const { book, headingLevel = 3 } = Astro.props;
const H = headingLevel === 2 ? 'h2' : 'h3';
const { title, order, cover, ages, tagline, buyLink } = book.data;
---

<article class="book-card card">
  {/* The cover and the title go to the same page. The title link is the
      one screen readers and the Tab key meet; the cover is a bigger target
      for a finger, taken out of the accessibility tree so the card isn't
      two identical stops in a row. */}
  <a href={u(`/books/${book.id}`)} class="cover-link" tabindex="-1" aria-hidden="true">
    <img src={u(cover)} alt="" width="322" height="322" loading="lazy" />
  </a>
  <div class="meta">
    <H class="title"><a href={u(`/books/${book.id}`)}>{title}</a></H>
    <p class="ages">Book {order}{ages && ` · Ages ${ages}`}</p>
    {tagline && <p class="tagline">{tagline}</p>}
    {buyLink && (
      <a class="btn btn-gold buy" href={buyLink} target="_blank" rel="noopener"
         aria-label={`${buyLabel(buyLink)}: ${title} (opens in a new tab)`}>
        <IconCart />{buyLabel(buyLink)}
      </a>
    )}
  </div>
</article>

<style>
  /* The grid stretches every card to the tallest one; the card passes
     that height down so the buy button can sink to the floor and line up
     across the row, however long the title or tagline above it runs. */
  .book-card {
    display: flex; flex-direction: column;
    padding: 18px 18px 22px;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .book-card:hover { transform: translateY(-4px) rotate(-0.6deg); box-shadow: var(--gg-shadow-lift); }
  .cover-link { position: relative; display: block; border-radius: var(--gg-radius-small); overflow: hidden; }
  .cover-link img { display: block; width: 100%; }
  .meta { padding-top: 14px; flex: 1; display: flex; flex-direction: column; align-items: flex-start; }
  .title { font-size: 1.25rem; }
  .title a { text-decoration: none; }
  .title a:hover { text-decoration: underline; text-decoration-thickness: 2px; }
  .ages { font-size: 0.85rem; font-weight: 800; color: var(--gg-green-ink); margin-top: 2px; }
  .tagline { font-size: var(--gg-text-small); color: var(--gg-ink-soft); margin-top: 6px; }
  /* whichever line of copy comes last takes up the slack, so the button
     keeps its 14px breath and still lands on the card's floor */
  .meta p:last-of-type { margin-bottom: auto; }
  .buy { margin-top: 14px; font-size: 0.95rem; }
</style>
