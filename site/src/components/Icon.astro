---
/* The site's icon system: Fluent Emoji Flat (Microsoft, MIT) by way of
 * Iconify, inlined as SVG at build time — nothing fetched at runtime.
 *
 * Call sites ask for a MEANING ("action-idea"), not a glyph name, so the
 * artwork underneath can change without touching a single page. The map
 * below is the only place that knows Fluent's vocabulary.
 *
 * Being SVG, these scale to any size without going soft, and they fill
 * their box — the drawn PNGs carried ~15% padding, which is why everything
 * used to read a size smaller than it was set.
 *
 * Decorative by contract: alt-less and aria-hidden, because the word beside
 * an icon always carries the meaning. Kim's own art still holds the header
 * nav and the two big welcome buttons; this set is for everything else.
 */
import { Icon as Iconify } from 'astro-icon/components';

const ICONS: Record<string, string> = {
  /* feelings — the Calming Corner picker, and the Mistake Maker's oops */
  'feeling-angry': 'angry-face',
  'feeling-sad': 'crying-face',
  'feeling-worried': 'worried-face',
  'feeling-frustrated': 'persevering-face',
  'feeling-tired': 'sleepy-face',
  'feeling-nervous': 'anxious-face-with-sweat',
  'feeling-silly-oops': 'winking-face-with-tongue',

  /* what grit looks like */
  'action-try-again': 'counterclockwise-arrows-button',
  'action-idea': 'light-bulb',
  'action-ask-for-help': 'handshake',
  'action-calm-break': 'person-in-lotus-position',
  'action-something-new': 'sparkles',
  /* Effort against resistance — the clearest picture of "this is heavy and
     I am doing it anyway", which is what trying something hard feels like.
     It replaced a lone puzzle piece, which read as "a part of something"
     rather than as difficulty, and which carries an autism-awareness
     association this page never intended to invoke. Skin-tone-neutral, like
     every other figure in this map. */
  'action-hard-thing': 'person-lifting-weights',
  'action-keep-going': 'person-climbing',
  'action-brain-grows': 'brain',
  'action-strong': 'flexed-biceps',
  'action-mountain-streak': 'mountain',
  'action-celebrate': 'party-popper',

  /* hearts and stars */
  'badge-star': 'star',
  'badge-star-burst': 'glowing-star',
  'heart-kind': 'yellow-heart',
  'heart-believe': 'red-heart',
  'heart-hands-helped': 'heart-hands',

  /* calm-down strategies */
  'calm-breathe': 'wind-face',
  'calm-five-senses': 'hand-with-fingers-splayed',
  'calm-water': 'droplet',
  'calm-flower-candle': 'cherry-blossom',
  'calm-kind-thought': 'thought-balloon',
  'calm-movement': 'person-walking',
  'calm-talk-grown-up': 'speaking-head',
  'calm-leaf': 'herb',

  /* printables */
  'printable-coloring-page': 'crayon',
  'printable-discussion-cards': 'speech-balloon',
  'printable-journal': 'notebook',
  'printable-certificate': 'trophy',
  'printable-book-guide': 'books',
  'printable-classroom': 'school',

  /* the stand-in for a character whose portrait Kim hasn't drawn yet —
     deliberately a generic goat, not Gritty, so it can't misname anyone */
  'character-coming': 'goat',

  /* interface */
  'ui-download': 'down-arrow',
  'ui-next-arrow': 'right-arrow',
  'ui-back': 'left-arrow',
  'ui-play': 'play-button',
  'ui-pause': 'pause-button',
  'ui-buy-cart': 'shopping-cart',
  'ui-look-inside': 'open-book',
};

interface Props {
  name: string;
  /* any CSS length; em ties it to the type beside it */
  size?: string;
  class?: string;
}
const { name, size = '1.3em', class: cls } = Astro.props;

const glyph = ICONS[name];
if (!glyph) {
  /* fails the build rather than shipping a hole where an icon should be */
  throw new Error(
    `Icon "${name}" is not in the map in src/components/Icon.astro. ` +
      `Known names: ${Object.keys(ICONS).join(', ')}`
  );
}
---

{/* inline width/height rather than a scoped class: Astro's scoped styles
    don't reach inside a child component, and this is a child component. */}
<Iconify
  name={`fluent-emoji-flat:${glyph}`}
  class={cls}
  aria-hidden="true"
  style={`width:${size};height:${size};flex:none;vertical-align:-0.15em`}
/>
