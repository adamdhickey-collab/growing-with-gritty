---
/* The meadow hero — style tile V3 "Alive", grown into the real site.
   Gritty (Kim's drawing) climbs out of the meadow grass; kids tap him to
   chat and answer with reply chips. Every conversation is CMS content
   (the meadow-chats collection) — the shell here is built once. Per Kim's
   2026 doc the hero is Gritty's alone: chats by other speakers stay in
   the CMS for their own pages, but nobody else appears here.

   Expression art: when Kim draws a mood (laughing, surprised, thinking…),
   drop the re-inked frames into public/images/gritty/ as
   gritty-<mood>-1.webp / -2 / -3 and that mood's reactions start using her
   drawing automatically. Until then, moods act through motion alone —
   never through generated art.

   The backpack: Kim wants Gritty wearing it in the meadow, always, and
   wearing it through his reactions too. So every frame here is a
   gritty-backpack-* drawing, and the line boil is retired — her backpack
   pose is one drawing, and three frames of the same picture is not a
   boil. His moods still act through motion as well as through her faces,
   which is what carries the moods she has not drawn (happy). */
import fs from 'node:fs';
import path from 'node:path';
import { getCollection } from 'astro:content';
import { u } from '../lib/url';
import MotionToggle from './MotionToggle.astro';

interface Props { heading: string; bubble: string; sayings?: string[] }
const { heading, bubble, sayings = [] } = Astro.props;

const chats = (await getCollection('meadow-chats'))
  .filter((c) => c.data.speaker === 'gritty')
  .sort((a, b) => a.data.order - b.data.order)
  .map(({ data: d }) => ({
    opener: d.opener,
    replies: [
      { say: d.replyA, react: d.reactionA, mood: d.moodA ?? 'happy' },
      { say: d.replyB, react: d.reactionB, mood: d.moodB ?? 'happy' },
      ...(d.replyC && d.reactionC
        ? [{ say: d.replyC, react: d.reactionC, mood: d.moodC ?? 'happy' }]
        : []),
    ],
  }));

/* Gritty's base pose ships with the site; extra moods appear the moment
   their frames exist. cwd is site/ for both `npm run dev` and CI builds.
   The frames come from gritty-talking/, not gritty/: Kim's drawings
   glance to the viewer's right, and here his bubble is on his left, so
   these are her frames with only the eye region flopped — his eyes look
   at his words (a hard rule, see README). New moods Kim draws go in
   gritty/ first and get the same treatment. */
const GRITTY_DIR = path.resolve(process.cwd(), 'public/images/gritty-talking');
let files: string[] = [];
try { files = fs.readdirSync(GRITTY_DIR); } catch { /* no art yet */ }

const BASE_POSE = u('/images/gritty-talking/gritty-backpack-1.webp');

/* Only moods drawn wearing the pack — anything else would blink it out for
   the length of a reaction. */
const moodFrames: Record<string, string[]> = {};
for (const f of files) {
  const m = f.match(/^gritty-backpack-([a-z]+)-[0-9]\.webp$/);
  if (m) (moodFrames[m[1]] ??= []).push(u(`/images/gritty-talking/${f}`));
}
for (const k in moodFrames) moodFrames[k].sort();

const payload = JSON.stringify({ chats, moods: moodFrames, sayings })
  .replace(/</g, '\\u003c');
---

<section class="meadow" aria-label="Gritty's Meadow" data-meadow>
  <img class="sun" src={u("/images/scenery/sun.webp")} alt="" aria-hidden="true"
       width="320" height="320" fetchpriority="high" />
  <img class="cloud c1" src={u("/images/scenery/cloud-puffy.webp")} alt="" aria-hidden="true"
       width="400" height="300" />
  <img class="cloud c2" src={u("/images/scenery/cloud-flat.webp")} alt="" aria-hidden="true"
       width="340" height="255" />
  <img class="cloud c3" src={u("/images/scenery/cloud-flat.webp")} alt="" aria-hidden="true"
       width="340" height="255" />
  <img class="cloud c4" src={u("/images/scenery/cloud-puffy.webp")} alt="" aria-hidden="true"
       width="400" height="300" />

  <div class="hills" aria-hidden="true">
    <img class="meadow-layer far" src={u("/images/scenery/meadow-far.webp")} alt=""
         width="5376" height="800" />
    <div class="school">
      <img src={u("/images/scenery/erin-school.webp")} alt="" width="560" height="354" />
      <span class="school-sign">Erin School</span>
    </div>
    <img class="tree" src={u("/images/scenery/tree.webp")} alt=""
         width="420" height="573" loading="lazy" />
    <img class="meadow-layer near" src={u("/images/scenery/meadow-near.webp")} alt=""
         width="5376" height="560" />
    <img class="bushes" src={u("/images/scenery/bushes.webp")} alt=""
         width="460" height="292" loading="lazy" />
    <div class="grass-border"
         style={`--grass-art: url('${u("/images/scenery/grass-border.webp")}')`}></div>
  </div>

  {/* The meadow is the one place on the site where things move by
      themselves, so the pause switch sits right here in the sky. */}
  <div class="meadow-tools"><MotionToggle /></div>

  <div class="hero-copy">
    <h1>{heading}</h1>
  </div>

  <div class="stage">
    <div class="say">
      <p class="bubble" data-say role="status">"{bubble.replace(/^"|"$/g, '')}"</p>
    </div>

    <div class="chips" data-chips hidden role="group" aria-label="What do you say back?">
      <button class="chip" data-chip hidden></button>
      <button class="chip" data-chip hidden></button>
      <button class="chip" data-chip hidden></button>
    </div>

    <button class="gritty" data-gritty aria-label="Tap Gritty — he wants to talk!" disabled>
      <img src={BASE_POSE} alt="Gritty the Goat wearing his backpack, hand-drawn by Kim Rekowski"
           width="640" height="777" fetchpriority="high" />
    </button>
    <p class="tap-hint" data-hint>
      <span data-hint-text>Tap Gritty to say hi!</span>
      <svg class="hint-arrow" viewBox="0 0 110 70" aria-hidden="true">
        {/* drawn twice: ink underneath, gold on top — a crayon arrow with
            an outline, pointing at the goat */}
        <path class="shaft-ink" d="M97,9 C89,33 64,49 34,51" />
        <path class="shaft-gold" d="M97,9 C89,33 64,49 34,51" />
        <polygon class="head" points="12,55 40,38 38,66" />
      </svg>
    </p>
  </div>

  <script type="application/json" data-meadow-data is:inline set:html={payload} />
</section>

<style>
  .meadow {
    position: relative; overflow: hidden;
    padding: 26px 0 96px;
    background: linear-gradient(180deg,
      var(--gg-sky-high) 0%, var(--gg-sky) 34%, var(--gg-sky-low) 64%);
  }

  /* ── the scenery ── */
  .sun {
    position: absolute; top: 8px; left: 4%; z-index: 0;
    width: clamp(88px, 11vw, 150px); height: auto;
  }

  /* Clouds drift mid-sky — below the headline, above the ridge line — and
     all travel the same way, because wind blows in one direction. Negative
     delays scatter them across the width from the first paint. */
  .cloud { position: absolute; height: auto; z-index: 0; }
  .c1 { top: 148px; left: 68%; width: clamp(104px, 12vw, 176px);
        animation: drift 110s linear -12s infinite; }
  .c2 { top: 236px; left: 18%; width: clamp(84px, 9vw, 136px); opacity: 0.95;
        animation: drift 140s linear -100s infinite; }
  .c3 { top: 210px; left: 58%; width: clamp(72px, 8vw, 120px); opacity: 0.9;
        animation: drift 95s linear -35s infinite; }
  .c4 { top: 168px; left: 78%; width: clamp(64px, 7vw, 108px); opacity: 0.8;
        animation: drift 165s linear -120s infinite; }
  @keyframes drift { from { translate: -12vw 0; } to { translate: 112vw 0; } }

  .hills { position: absolute; inset: 0; pointer-events: none; }

  /* Each meadow layer is a full-depth painting: ridge and brushwork at
     the top dissolving into its own flat green, solid to the bottom of
     the hero. Nothing hands off to CSS colour mid-scene, so there is no
     seam to see at any width. min-height + bottom-anchored cover keeps
     the whole ridge in frame: when the natural height is short, cover
     scales by height and crops the mirrored wings, never the drawing. */
  .meadow-layer {
    position: absolute; left: -2%; width: 104%; bottom: 0;
    max-width: none; height: auto; display: block;
    object-fit: cover; object-position: 50% 100%;
  }
  .meadow-layer.far { z-index: 1; min-height: 300px; }
  .meadow-layer.near { z-index: 3; min-height: 175px; }

  /* Erin School and the tree flank the meadow — school on the left, tree
     on the right — standing on the far ground with the near band closing
     over their bases: the oldest trick in scenery. */
  .school {
    position: absolute; z-index: 2; left: 3%; bottom: 148px;
    width: clamp(170px, 26vw, 400px);
    container-type: inline-size;
  }
  .school img { width: 100%; height: auto; display: block; }
  /* Placed on the green sign panel in the drawing, in percentages of the
     building so it holds at every width. cqw ties the type to the
     building, not the viewport. */
  .school-sign {
    position: absolute; left: 65%; top: 23.2%; translate: -50% 0;
    width: 38%; text-align: center;
    font-family: var(--gg-display); font-weight: 600;
    font-size: 4.1cqw; line-height: 1; letter-spacing: 0.01em;
    color: #fff; white-space: nowrap;
  }

  .tree {
    position: absolute; z-index: 2; right: 3%; bottom: 128px;
    width: clamp(96px, 14vw, 216px); height: auto;
    transform-origin: 50% 100%;
  }

  .bushes {
    position: absolute; z-index: 4; right: 26%; bottom: 56px;
    width: clamp(58px, 7vw, 104px); height: auto;
    transform-origin: 50% 100%;
  }

  /* The grass border is the frontmost detail, ahead of Gritty himself, so
     he stands *in* the meadow rather than on it. It repeats at its own
     aspect ratio — a stretched daisy is an oval. */
  .grass-border {
    position: absolute; z-index: 7; left: -1%; right: -1%; bottom: -4px;
    height: 82px;
    background: var(--grass-art) repeat-x bottom center / auto 82px;
    transform-origin: 50% 100%;
  }

  /* ── the meadow breathes: all compositor-only, all optional ── */
  @media (prefers-reduced-motion: no-preference) {
    .sun { animation: sun-glow 6s ease-in-out infinite; }
    .tree { animation: tree-sway 7s ease-in-out infinite; }
    .bushes { animation: tree-sway 8.5s ease-in-out -4s infinite; }
    .grass-border { animation: grass-lean 5.5s ease-in-out infinite; }
    .hint-arrow { animation: arrow-nudge 1.8s var(--gg-ease-back) infinite; }
  }
  @keyframes arrow-nudge {
    0%, 100% { translate: 0 0; } 45% { translate: -7px 7px; }
  }
  @keyframes sun-glow {
    0%, 100% { scale: 1; } 50% { scale: 1.06; }
  }
  @keyframes tree-sway {
    0%, 100% { rotate: -2.2deg; } 50% { rotate: 2.2deg; }
  }
  /* blades lean rather than slide — a skew from the roots reads as wind */
  @keyframes grass-lean {
    0%, 100% { transform: skewX(-2.1deg); } 50% { transform: skewX(2.1deg); }
  }

  .meadow-tools {
    position: relative; z-index: 9;
    display: flex; justify-content: flex-end;
    padding-inline: 16px; margin-bottom: -8px;
  }
  /* wide enough that the title never wraps under it, the switch shares
     the title's row and the title keeps its place */
  @media (min-width: 900px) { .meadow-tools { margin-bottom: -38px; } }

  /* ── the words: the title carries the hero, the motto whispers ── */
  .hero-copy {
    position: relative; z-index: 5; text-align: center;
    padding: 26px 24px 34px; display: grid; gap: 10px; justify-items: center;
  }
  .hero-copy h1 {
    color: var(--gg-blue-deep);
    font-size: clamp(2.3rem, 6vw, 4rem); line-height: 1.04;
    text-shadow: 0 2px 0 rgba(255, 255, 255, 0.5);
  }

  /* ── the stage ── */
  .stage {
    position: relative; z-index: 6;
    display: grid; justify-items: center; gap: 10px;
    margin-top: 14px; padding-inline: 16px;
  }

  /* min-height reserves room so the chips don't jump when the bubble text
     changes; align-content keeps the bubble itself content-sized instead
     of stretching into that reserve. */
  .say { display: grid; justify-items: center; align-content: start;
         gap: 6px; min-height: 96px; }
  .bubble {
    position: relative; background: #fff; border: 3px solid var(--gg-ink);
    border-radius: 26px 30px 28px 26px / 28px 26px 30px 28px;
    padding: 13px 20px; max-width: 44ch;
    font-family: var(--gg-hand); font-size: 1.3rem; line-height: 1.35;
    color: var(--gg-ink); box-shadow: var(--gg-shadow); text-align: center;
  }
  /* the tail points down at whoever's talking */
  .bubble::before, .bubble::after {
    content: ''; position: absolute; left: 50%;
    background: #fff; border: 3px solid var(--gg-ink); border-radius: 50%;
  }
  .bubble::before { width: 15px; height: 12px; bottom: -17px; margin-left: -18px; }
  .bubble::after { width: 8px; height: 7px; bottom: -28px; margin-left: -4px; }
  .bubble.cheer { border-color: var(--gg-gold-ink); color: var(--gg-gold-ink); background: #FFFDF4; }
  .bubble.cheer::before, .bubble.cheer::after { border-color: var(--gg-gold-ink); background: #FFFDF4; }
  .bubble.enter { animation: bpop 420ms var(--gg-ease-back); }
  @keyframes bpop { from { opacity: 0; scale: 0.86 0.94; } to { opacity: 1; scale: 1 1; } }

  /* ── the reply chips: what YOU say back ── */
  .chips { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; }
  /* an author display beats the UA's [hidden] — without this the chips a
     kid just chose from stayed on screen under Gritty's answer */
  .chips[hidden] { display: none; }
  .chip {
    min-height: var(--gg-tap); padding: 0.5em 1.2em;
    background: #fff; color: var(--gg-blue);
    border: 3px solid var(--gg-blue); border-radius: 999px;
    font-family: var(--gg-display); font-weight: 600; font-size: 1rem;
    cursor: pointer;
    transition: translate 0.16s ease, scale 0.16s ease, background 0.16s ease;
  }
  .chip:hover { translate: 0 -2px; background: color-mix(in srgb, var(--gg-sky) 40%, #fff); }
  .chip:active { scale: 0.95; }

  /* ── Gritty ── */
  .gritty {
    position: relative; width: min(184px, 38vw); aspect-ratio: 640 / 777;
    margin-bottom: -46px;
    border: none; background: none; padding: 0; cursor: pointer;
    transform-origin: 50% 97%; /* hooves stay planted */
    transition: translate 900ms var(--gg-ease-bouncy);
  }
  /* a pool of shade under his hooves, not a floating silhouette — this is
     what actually puts him ON the ground */
  .gritty::after {
    content: ''; position: absolute; z-index: -1;
    left: 8%; right: 8%; bottom: -2px; height: 30px;
    background: radial-gradient(50% 50% at 50% 50%,
      rgba(46, 60, 40, 0.35) 0%, rgba(46, 60, 40, 0.18) 55%, transparent 75%);
  }
  .gritty:disabled { cursor: default; }
  .gritty:focus-visible { outline: 3px solid var(--gg-gold); outline-offset: 6px; border-radius: 18px; }
  /* contain, not fill: the expression drawings are a hair squarer than the
     base frames, and stretching Gritty for a fifth of a second is the kind
     of wrongness you feel without being able to name it. */
  .gritty img { position: absolute; inset: 0; width: 100%; height: 100%;
                object-fit: contain; }

  /* When JS will run, he starts tucked behind the front hill and climbs
     out (.arrived). Without JS — or in old browsers — he's simply there. */
  @media (scripting: enabled) {
    .gritty:not(.arrived) { translate: 0 130%; }
  }

  /* The hint is the page's one call to action: hand-lettered words and a
     big gold crayon arrow aimed straight at the goat. */
  .tap-hint {
    position: relative; z-index: 8;
    display: grid; justify-items: center; gap: 0;
    font-family: var(--gg-display); font-weight: 600;
    font-size: 1rem; color: var(--gg-blue-deep);
    text-shadow: 0 0 6px var(--gg-paper), 0 0 12px var(--gg-paper),
                 0 2px 0 rgba(255, 255, 255, 0.8);
    rotate: -3deg;
    transition: opacity 300ms ease;
  }
  .hint-arrow { width: 76px; height: auto; margin-top: -2px; }
  .hint-arrow .shaft-ink {
    fill: none; stroke: var(--gg-ink); stroke-width: 13; stroke-linecap: round;
  }
  .hint-arrow .shaft-gold {
    fill: none; stroke: var(--gg-gold); stroke-width: 7.5; stroke-linecap: round;
  }
  .hint-arrow .head {
    fill: var(--gg-gold); stroke: var(--gg-ink);
    stroke-width: 4; stroke-linejoin: round;
  }
  @media (scripting: none) {
    .tap-hint { display: none; } /* no JS, nothing to tap */
  }

  @media (prefers-reduced-motion: no-preference) {
    /* One drawing now, so the breath is what keeps him alive. Scale is
       compositor-only, so it can never jank a phone. */
    .gritty { animation: breathe 3.7s ease-in-out infinite; }
  }
  @keyframes breathe { 0%, 100% { scale: 1 1; } 50% { scale: 1 1.03; } }

  /* moods, acted out in motion (his emote replaces breathing while it runs) */
  .gritty.e-happy { animation: hop 620ms var(--gg-ease-back); }
  .gritty.e-proud { animation: hop 560ms var(--gg-ease-back) 2; }
  .gritty.e-laugh { animation: giggle 760ms ease-in-out; }
  .gritty.e-surprised { animation: startle 520ms var(--gg-ease-back); }
  .gritty.e-thinking { animation: sway 1500ms ease-in-out; }
  @keyframes hop {
    0% { scale: 1 1; translate: 0 0; }
    18% { scale: 1.06 0.9; translate: 0 4px; }   /* anticipation: dip */
    45% { scale: 0.94 1.1; translate: 0 -18px; } /* stretch going up */
    72% { scale: 1.05 0.95; translate: 0 2px; }  /* squash on landing */
    100% { scale: 1 1; translate: 0 0; }
  }
  @keyframes giggle {
    0%, 100% { rotate: 0deg; scale: 1 1; }
    20% { rotate: -4deg; scale: 1.03 0.96; }
    40% { rotate: 4deg; }
    60% { rotate: -3deg; scale: 1.02 0.97; }
    80% { rotate: 2deg; }
  }
  @keyframes startle {
    0% { scale: 1 1; translate: 0 0; }
    30% { scale: 0.96 1.12; translate: 0 -12px; } /* jump! */
    60% { scale: 1.04 0.94; translate: 0 1px; }
    100% { scale: 1 1; translate: 0 0; }
  }
  @keyframes sway {
    0%, 100% { rotate: 0deg; }
    30% { rotate: -2.5deg; }
    70% { rotate: 2deg; }
  }

  /* Side by side on desktop: the bubble speaks from his left, its thought
     dots drift toward him instead of down, and with the words out of his
     column Gritty gets to be the size a hero deserves. */
  @media (min-width: 760px) {
    /* Gritty is the tallest thing here and spans both rows, so they are
       two equal halves of his height: the bubble sits on the foot of the
       top half and the reply chips hang from the top of the bottom half.
       That keeps the bubble's bottom edge on his midline whether or not
       the chips are showing — and his mouth sits just above that line
       (about 41% down the drawing), which is where the thought dots leave
       the bubble. Centre the bubble in a row of its own and it floats up
       to his ear the moment the chips take a row beneath it. */
    .stage {
      grid-template-columns: minmax(0, 46ch) auto;
      grid-template-rows: 1fr 1fr;
      justify-content: center; align-items: center;
      column-gap: 40px; margin-top: 4px;
    }
    .say, .chips { grid-column: 1; justify-self: end; }
    .say { grid-row: 1; justify-items: end; align-self: end; align-content: end; }
    .chips { grid-row: 2; align-self: start; justify-content: flex-end; }
    .bubble { text-align: left; }
    .gritty { grid-column: 2; grid-row: 1 / 3; width: min(280px, 26vw); }
    /* the hint shares his cell and floats up beside his head, the arrow
       diving toward him */
    .tap-hint {
      grid-column: 2; grid-row: 1 / 3;
      align-self: start; justify-self: end;
      translate: 36% 18px;
    }
    /* the thought dots walk toward Gritty along his mouth line, which
       runs a hair under the bubble's bottom edge */
    .bubble::before {
      left: auto; right: -21px; bottom: 0; margin-left: 0;
      width: 14px; height: 11px;
    }
    .bubble::after {
      left: auto; right: -33px; bottom: -10px; margin-left: 0;
    }
  }

  @media (max-width: 600px) {
    .meadow { padding-bottom: 78px; }
    .bubble { font-size: 1.15rem; }
    /* the hint takes the row between the bubble and Gritty, its arrow
       diving down at him */
    .say { grid-row: 1; }
    .chips { grid-row: 2; }
    .tap-hint {
      grid-row: 3; justify-self: end;
      margin-right: 4%; margin-bottom: -40px;
      font-size: 0.95rem;
    }
    .gritty { grid-row: 4; }
    .tap-hint .hint-arrow { width: 62px; }
    .c2 { top: 300px; }
    /* the headline wraps to two full-width lines here, so the sun ducks
       into the corner instead of sitting behind the words */
    .sun { width: 64px; top: 4px; left: 3%; }
    /* school and tree shrink and tuck so Gritty keeps the stage */
    .school { width: clamp(200px, 56vw, 270px); left: -3%; bottom: 96px; }
    .tree { width: clamp(70px, 19vw, 104px); right: 2%; bottom: 116px; }
    .bushes { display: none; } /* three set pieces is enough on a phone */
  }
</style>

<!-- Celebration sparks are the one thing JS creates, so their keyframes
     must be global (scoped keyframes wouldn't reach JS-made elements). -->
<style is:global>
  @keyframes gg-spark {
    0% { translate: 0 0; scale: 0; opacity: 1; }
    20% { scale: 1; }
    100% { translate: var(--dx) var(--dy); scale: 0.4; opacity: 0; }
  }
</style>

<script>
  const section = document.querySelector<HTMLElement>('[data-meadow]');
  if (section) {
    const data = JSON.parse(
      section.querySelector('[data-meadow-data]')!.textContent!,
    ) as {
      chats: { opener: string;
               replies: { say: string; react: string; mood: string }[] }[];
      moods: Record<string, string[]>;
      sayings: string[];
    };

    /* seasonal meadow — automatic, cosmetic, nothing to unlock */
    const month = new Date().getMonth();
    if (month < 2 || month === 11) section.dataset.season = 'winter';
    else if (month >= 8) section.dataset.season = 'autumn';

    const gritty = section.querySelector<HTMLButtonElement>('[data-gritty]')!;
    const frames = Array.from(gritty.querySelectorAll('img'));
    const baseSrcs = frames.map((f) => f.src); /* one pose, kept for restore */
    const say = section.querySelector<HTMLElement>('[data-say]')!;
    const chipBox = section.querySelector<HTMLElement>('[data-chips]')!;
    const chips = Array.from(chipBox.querySelectorAll<HTMLButtonElement>('[data-chip]'));
    const hint = section.querySelector<HTMLElement>('[data-hint]')!;
    const hintText = section.querySelector<HTMLElement>('[data-hint-text]')!;
    const calm = matchMedia('(prefers-reduced-motion: reduce)');
    /* the OS setting, or the site's own "Pause animations" switch */
    const isCalm = () => calm.matches || document.documentElement.dataset.motion === 'calm';

    let gi = 0; // next chat
    let current: (typeof data.chats)[0] | null = null;

    /* he climbs out of the meadow */
    gritty.disabled = false;
    setTimeout(() => gritty.classList.add('arrived'), 350);

    function speak(text: string, opts: { cheer?: boolean } = {}) {
      say.textContent = `"${text.replace(/^"|"$/g, '')}"`;
      say.classList.remove('enter', 'cheer');
      void say.offsetWidth;
      say.classList.add('enter');
      if (opts.cheer) say.classList.add('cheer');
    }

    /* ——— Kim's sayings, taking turns while nobody has tapped him ———
       An idle carousel must not narrate itself: aria-live goes quiet for
       the rotation and comes back on for anything a kid actually caused. */
    let idleTimer = 0;
    let si = 0;
    function stopIdle() {
      clearInterval(idleTimer);
      idleTimer = 0;
      say.setAttribute('aria-live', 'polite');
    }
    function startIdle() {
      /* text that changes by itself is motion too: paused, it holds still */
      if (data.sayings.length < 2 || idleTimer || isCalm()) return;
      say.setAttribute('aria-live', 'off');
      idleTimer = window.setInterval(() => {
        si = (si + 1) % data.sayings.length;
        speak(data.sayings[si]);
      }, 6000);
    }
    /* the bubble ships with sayings[0], so the rotation picks up from there */
    si = Math.max(0, data.sayings.indexOf(say.textContent!.replace(/^"|"$/g, '')));
    startIdle();
    /* the pause switch (and the OS setting) stop and restart the rotation —
       but never barge in on a conversation that has already started */
    const onMotion = () => { if (isCalm()) stopIdle(); else if (!current) startIdle(); };
    document.addEventListener('gg:motion', onMotion);
    calm.addEventListener('change', onMotion);

    function emote(mood: string) {
      gritty.classList.remove('e-happy', 'e-proud', 'e-laugh', 'e-surprised', 'e-thinking');
      void gritty.offsetWidth;
      gritty.classList.add(`e-${mood}`);
      const art = data.moods[mood];
      if (art?.length) { /* Kim's expression drawing, once it exists */
        frames.forEach((f, i) => { f.src = art[i % art.length]; });
        setTimeout(() => frames.forEach((f, i) => { f.src = baseSrcs[i]; }), 1900);
      }
    }

    /* gold sparks — celebration only, and never under reduced motion */
    function sparks() {
      if (isCalm()) return;
      const r = gritty.getBoundingClientRect();
      const box = document.createElement('div');
      box.setAttribute('aria-hidden', 'true');
      box.style.cssText =
        `position:fixed;left:${r.left + r.width / 2}px;top:${r.top + r.height / 3}px;` +
        'z-index:150;pointer-events:none;';
      const hues = ['#D9A93F', '#7FA86B', '#2C5F8A', '#BDD7E7', '#F2D48A'];
      for (let i = 0; i < 12; i++) {
        const s = document.createElement('i');
        const ang = (Math.PI * 2 * i) / 12;
        const dist = 70 + (i % 3) * 26;
        s.style.cssText =
          'position:absolute;width:9px;height:9px;border-radius:50%;' +
          `background:${hues[i % hues.length]};` +
          `--dx:${Math.cos(ang) * dist}px;--dy:${Math.sin(ang) * dist - 34}px;` +
          `animation:gg-spark 850ms ease-out ${i * 12}ms forwards;`;
        box.appendChild(s);
      }
      document.body.appendChild(box);
      setTimeout(() => box.remove(), 1300);
    }

    function showChips(replies: { say: string }[]) {
      chips.forEach((chip, i) => {
        const reply = replies[i];
        chip.hidden = !reply;
        if (reply) chip.textContent = reply.say;
      });
      chipBox.hidden = false;
      chips.find((c) => !c.hidden)?.focus({ preventScroll: true });
    }

    function startChat(chat: (typeof data.chats)[0]) {
      stopIdle(); /* a real conversation outranks the waiting sayings */
      current = chat;
      hint.style.opacity = '0';
      speak(chat.opener);
      showChips(chat.replies);
    }

    gritty.addEventListener('click', () => {
      /* mid-question, a tap is just a giggle — the chips are the next step */
      if (!chipBox.hidden) { emote('laugh'); return; }
      emote('happy');
      startChat(data.chats[gi % data.chats.length]);
      gi += 1;
    });

    chips.forEach((chip, i) => {
      chip.addEventListener('click', () => {
        const reply = current?.replies[i];
        if (!reply) return;
        chipBox.hidden = true;
        say.textContent = '…';
        setTimeout(() => { /* a beat of thought makes the answer feel real */
          speak(reply.react, { cheer: reply.mood === 'proud' });
          emote(reply.mood);
          if (reply.mood === 'proud') sparks();
          gritty.focus({ preventScroll: true });
          hintText.textContent = 'Tap Gritty again!';
          hint.style.opacity = '1';
        }, 420);
      });
    });
  }
</script>
