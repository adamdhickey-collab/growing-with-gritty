---
/* The header is the first thing a child sees, so the nav speaks their
   language: Kim-style drawings first, words underneath. Each destination
   gets its own icon (public/images/nav/), big enough that the crayon
   detail actually reads. */
import { u } from '../lib/url';
const links = [
  { href: '/meet-gritty', label: 'Meet Gritty', icon: 'meet-gritty' },
  { href: '/books', label: 'Books', icon: 'books' },
  { href: '/grit-zone', label: 'Grit Zone', icon: 'grit-zone' },
  { href: '/mistake-maker', label: 'Mistake Maker', icon: 'mistake-maker' },
  { href: '/calming-corner', label: 'Calming Corner', icon: 'calming-corner' },
  { href: '/grown-ups', label: 'Grown-Ups', icon: 'grown-ups' },
  { href: '/about', label: 'About Kim', icon: 'about-kim' },
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header>
  <div class="wrap bar">
    <a class="wordmark" href={u("/")} data-home>
      <img src={u("/icon.png")} alt="" width="58" height="58" />
      <span class="wordmark-text">
        <span class="site-name">Growing<em>with</em>Gritty</span>
        <span class="site-motto">Build Grit. Grow Strong. Never Quit!</span>
      </span>
    </a>
    <nav aria-label="Main">
      {links.map(({ href, label, icon }) => (
        <a href={u(href)} aria-current={path.startsWith(href) ? 'page' : undefined}>
          <img src={u(`/images/nav/${icon}.webp`)} alt="" width="64" height="64" loading="eager" />
          <span>{label}</span>
        </a>
      ))}
    </nav>
  </div>
</header>

<style>
  header {
    background: color-mix(in srgb, var(--gg-paper) 88%, #fff);
    border-bottom: 1px solid rgba(42, 50, 56, 0.08);
  }
  .bar {
    display: flex; flex-wrap: wrap; align-items: center;
    gap: 10px 28px; padding-block: 12px;
  }
  .wordmark {
    display: inline-flex; align-items: center; gap: 6px;
    font-family: var(--gg-display); font-weight: 700; font-size: 1.85rem;
    color: var(--gg-blue); text-decoration: none; min-height: var(--gg-tap);
  }
  /* His head is the way home, so it acts like him: the same curious tilt
     the nav drawings do on hover, a crouch while pressed, and — on click —
     the very hop he does down in the meadow, before the page follows him. */
  /* The drawing carries about 6% of clear air on every side, so at 116px
     the ink itself only spans ~101px. He's rendered at 132px (ink ~115px)
     but keeps a 116px footprint: the negative margins fold the extra back
     into the box, so the header stays 141px tall and the wordmark doesn't
     move. He spills 8px into the header's own 12px padding above and
     below — nothing clips — and the horizontal split (12 left, 4 right)
     lets him grow mostly outward into the page gutter, holding the gap
     between his face and the name at ~10px. */
  .wordmark img {
    width: 132px; height: 132px; object-fit: contain;
    margin: -8px -4px -8px -12px;
    transform-origin: 50% 88%; /* he springs from the chin, hooves planted */
    transition: rotate 0.18s var(--gg-ease-back), scale 0.18s var(--gg-ease-back);
  }
  .wordmark:hover img { rotate: -5deg; scale: 1.08; }
  .wordmark:active img { rotate: -3deg; scale: 0.92; } /* winding up to jump */
  .wordmark.away img { animation: logo-hop 460ms var(--gg-ease-back); }
  /* every frame states all three properties, so the hop looks the same
     whether a mouse is hovering (-5deg) or a finger tapped it (0deg) */
  @keyframes logo-hop {
    0%   { scale: 1 1;       translate: 0 0;     rotate: 0deg; }
    18%  { scale: 1.1 0.86;  translate: 0 4px;   rotate: 0deg; }   /* anticipation: dip */
    45%  { scale: 0.92 1.12; translate: 0 -12px; rotate: -7deg; }  /* stretch going up */
    72%  { scale: 1.07 0.93; translate: 0 1px;   rotate: 0deg; }   /* squash on landing */
    100% { scale: 1 1;       translate: 0 0;     rotate: 0deg; }
  }
  /* one word, one size, one weight — the colours alone tell the parts */
  .wordmark-text { display: grid; gap: 2px; line-height: 1.1; }
  /* one step lighter than green-ink so "with" sits up out of the blue
     without shouting — still the muted meadow green, not a leaf green */
  .wordmark em {
    font-style: normal; font-weight: inherit; font-size: inherit;
    color: var(--gg-green-lift);
    /* h followed by a capital G leaves 1.8px where the wordmark's other
       letter gaps sit at 1.2 — enough to read as a word break in a name
       that is meant to be one word. Closed to the median. In em so it
       holds at the smaller header size too; only this one boundary moves,
       the letters inside "with" keep their own spacing. */
    margin-right: -0.026em;
  }
  /* the motto rides under the name — the site introduces itself in full */
  /* dressed exactly like a nav label, so the header speaks one language */
  .site-motto {
    font-family: var(--gg-display); font-weight: 600;
    font-size: 0.8rem; line-height: 1.1;
    color: var(--gg-blue-deep);
    /* Left-aligned under the name at its natural word spacing — it used
       to be justified out to the name's width, which stretched the gaps
       between four short words. The half-pixel keeps the left inks on one
       column: Fredoka's B carries 0.5px less left bearing than the
       name's G. */
    text-align: left;
    padding-left: 0.5px;
  }

  nav { display: flex; flex-wrap: wrap; gap: 2px; margin-left: auto; }

  /* Picture over word: each link is a little card a child can read before
     they can read. The icon is the star; the label confirms it. */
  nav a {
    display: grid; justify-items: center; gap: 3px;
    /* 6px sides, not 10: at the floor size the seven labels grew 62px,
       and 1072px of bar holds the wordmark and the nav with 45px to spare
       only once each link gives 8 back */
    padding: 8px 6px 7px; border-radius: 16px;
    min-width: 76px; min-height: var(--gg-tap);
    font-family: var(--gg-display); font-weight: 600;
    /* the small-text floor: these are the first words a new reader meets */
    font-size: var(--gg-text-small); line-height: 1.1; text-align: center;
    color: var(--gg-blue-deep); text-decoration: none;
    transition: background 0.15s ease, translate 0.15s ease;
  }
  nav a img { width: 48px; height: 48px; object-fit: contain;
              transition: rotate 0.18s var(--gg-ease-back), scale 0.18s var(--gg-ease-back); }
  nav a:hover { background: color-mix(in srgb, var(--gg-sky) 45%, transparent); translate: 0 -2px; }
  nav a:hover img { rotate: -5deg; scale: 1.12; }
  nav a:focus-visible { outline: 3px solid var(--gg-focus); outline-offset: 2px; }
  nav a[aria-current='page'] {
    background: var(--gg-blue); color: #fff;
  }
  /* his own drawing shouldn't tilt while you're standing on its page */
  nav a[aria-current='page'] img { rotate: 0deg; scale: 1; }

  @media (max-width: 900px) {
    .bar { justify-content: center; }
    .wordmark { font-size: 1.45rem; gap: 5px; }
    /* the name shrinks here but the motto didn't, so the motto became the
       wider of the two and poked out past the name. A step down puts the
       name back in charge of the column. */
    .site-motto { font-size: 0.75rem; }
    /* same trick at the small size: 96px drawn, 84px footprint */
    .wordmark img { width: 96px; height: 96px; margin: -6px -3px -6px -9px; }
    nav { margin-left: 0; justify-content: center; }
    nav a { min-width: 68px; }
    nav a img { width: 38px; height: 38px; }
  }

  @media (prefers-reduced-motion: reduce) {
    nav a, nav a img, .wordmark img { transition: none; animation: none; }
  }
</style>

<script>
  /* Clicking Gritty's head hops before it navigates — the feedback comes
     first, then home. The hop runs 460ms and we leave at 400ms, so the
     landing is seen and only the settle is cut by the page change.
     Modifier clicks (new tab and friends) stay native, reduced-motion
     visitors get the fastest feedback there is — instant — and if you're
     already home, he simply hops for you instead of reloading the page. */
  const home = document.querySelector<HTMLAnchorElement>('[data-home]');
  if (home) {
    let leaving = false;
    home.addEventListener('click', (e) => {
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      e.preventDefault();
      if (leaving) return;
      home.classList.remove('away');
      void home.offsetWidth; /* restart the hop if it's mid-flight */
      home.classList.add('away');
      const here = location.pathname.replace(/\/$/, '') || '/';
      const there = new URL(home.href).pathname.replace(/\/$/, '') || '/';
      if (here === there) {
        home.addEventListener('animationend',
          () => home.classList.remove('away'), { once: true });
        return;
      }
      leaving = true;
      setTimeout(() => { location.href = home.href; }, 400);
    });
  }
</script>
