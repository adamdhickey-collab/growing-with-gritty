---
/* The cart on buy buttons. An inline SVG rather than the 🛒 emoji: it
 * inherits the button's text color, scales with its font size, and sits as
 * its own flex item so the button's gap actually separates it from the
 * label. ICONS.md maps this spot to a future hand-drawn ui-buy-cart.png —
 * when that art lands, this component is the only file to change. */
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="1.05em" height="1.05em"
     fill="none" stroke="currentColor" stroke-width="2.1"
     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  <circle cx="9.5" cy="20" r="1.5" />
  <circle cx="16.5" cy="20" r="1.5" />
  <path d="M3.5 4h2.2l2.3 11a1.8 1.8 0 0 0 1.76 1.4h6.9a1.8 1.8 0 0 0 1.75-1.36L20.5 8.2H6.6" />
</svg>
