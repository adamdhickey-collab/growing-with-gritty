---
import { u } from '../lib/url';
import MotionToggle from './MotionToggle.astro';
const year = new Date().getFullYear();
---

<footer>
  <div class="wrap inner">
    <p class="motto">"I have grit! I don't quit!"</p>
    <p class="tagline">Build Grit. Grow Strong. Never Quit!</p>
    <nav aria-label="Footer">
      <a href={u("/meet-gritty")}>Meet Gritty</a>
      <a href={u("/books")}>Books</a>
      <a href={u("/grit-zone")}>Grit Zone</a>
      <a href={u("/mistake-maker")}>Mistake Maker</a>
      <a href={u("/calming-corner")}>Calming Corner</a>
      <a href={u("/grown-ups")}>Grown-Ups</a>
      <a href={u("/about")}>About Kim</a>
    </nav>
    {/* On every page, so motion can be paused from wherever it is noticed —
        the meadow carries a second, closer copy of the same switch. The
        conformance line rides beside it: the switch is the most visible
        piece of the standard being claimed, so the claim stands next to
        the proof rather than buried in the copyright line. */}
    <div class="tools">
      <MotionToggle />
      {/* Names the standard and its level, and links to the standard
          itself so the claim can be checked. "Built to meet" is the honest
          verb: this is Kim's own conformance claim, not a third-party
          certification, and nothing here should imply one. */}
      <p class="a11y">Built to meet <a
        href="https://www.w3.org/TR/WCAG22/"
        target="_blank" rel="noopener"
        aria-label="WCAG 2.2 Level AA — the accessibility standard this site is built to meet (opens in a new tab)"
      >WCAG 2.2 Level AA</a></p>
    </div>
    <p class="legal">
      © {year} Kim Rekowski · All character art by Kim Rekowski ·
      This site collects no personal information — activities happen right on
      your device.
    </p>
  </div>
</footer>

<style>
  footer {
    /* the air above the footer belongs to the page, not the footer —
       see main > :last-child in global.css */
    background: var(--gg-blue);
    color: #fff;
    /* deep blue on blue is invisible (≈1.5:1); the ring goes white here */
    --gg-focus: #fff;
  }
  .inner { padding-block: 44px 36px; display: grid; gap: 14px; justify-items: center; text-align: center; }
  .motto { font-family: var(--gg-hand); font-size: 1.7rem; color: #fff; }
  .tagline { font-family: var(--gg-display); font-weight: 500; color: var(--gg-sky); }
  nav { display: flex; flex-wrap: wrap; gap: 4px 10px; justify-content: center; }
  nav a {
    color: #fff; text-decoration: none; font-family: var(--gg-display);
    padding: 10px 14px; min-height: var(--gg-tap);
    display: inline-flex; align-items: center; border-radius: 999px;
  }
  nav a:hover { background: rgba(255, 255, 255, 0.14); color: #fff; }
  /* the switch and the claim share a row, and wrap to two on a phone */
  .tools {
    display: flex; flex-wrap: wrap; align-items: center;
    justify-content: center; gap: 10px 20px;
  }
  /* Small, as asked — but not below the site's own informational floor
     (--gg-text-small), and lettered in white rather than the sky the
     legal line uses: sky on this blue is 4.51:1, which clears AA for
     small text by a hundredth. A line whose whole subject is
     accessibility should not sit on that margin, so it takes the 6.8:1. */
  .a11y { font-size: var(--gg-text-small); color: #fff; }
  .a11y a { color: #fff; text-decoration-thickness: 2px; }

  /* Sky on this blue measures 4.51:1 — it cleared AA for small text by
     a hundredth, which is not a margin so much as a coincidence, and any
     later nudge to either token would have broken it silently. Mixing a
     little card white into the sky lifts it to 5.07:1 while staying the
     same cool, quiet grey-blue against the white footer links. Sized at
     the site's own informational floor rather than 0.88rem. */
  .legal {
    font-size: var(--gg-text-small); max-width: 60ch;
    color: color-mix(in srgb, var(--gg-sky) 72%, var(--gg-card));
  }
</style>
