---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import GrittyHero from '../components/GrittyHero.astro';
import Icon from '../components/Icon.astro';
import { u } from '../lib/url';

const characters = (await getCollection('characters')).sort((a, b) => a.data.order - b.data.order);
const rendered = await Promise.all(characters.map(async (c) => ({ c, Content: (await render(c)).Content })));

const gritIs: { icon: string; label: string }[] = [
  { icon: 'action-hard-thing', label: 'Trying something hard' },
  { icon: 'action-keep-going', label: 'Keeping going' },
  { icon: 'action-idea', label: 'Trying a new idea' },
  { icon: 'action-ask-for-help', label: 'Asking for help' },
  { icon: 'action-try-again', label: 'Trying again' },
  { icon: 'heart-believe', label: 'Believing in yourself' },
];
---

<Base
  title="Meet Gritty — Growing with Gritty"
  description="Meet Gritty the Goat and his family: Grandpa Goat, Gabby, Grandma Goat, and Gibby — the characters of Kim Rekowski's book series."
>
  <section class="band hero-gold">
    <GrittyHero>
      <Fragment slot="title">Hi! I'm Gritty!</Fragment>
      <Fragment slot="quote">
        "I don't always get things right the first time. But that's okay!
        I keep trying, learn from my mistakes, and never give up."
      </Fragment>
    </GrittyHero>
  </section>

  <section class="band band-deep">
    <div class="wrap">
      <p class="eyebrow">So…</p>
      <h2>What is grit?</h2>
      <p class="note">Grit can look like a lot of things. All of these count!</p>
      <ul class="grit-grid" role="list">
        {gritIs.map(({ icon, label }) => (
          <li class="grit-item card">
            <span class="grit-emoji" aria-hidden="true">
              <Icon name={icon} size="3.6rem" />
            </span>
            <span>{label}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <p class="eyebrow">The whole herd</p>
      <h2>Gritty's family &amp; friends</h2>
      <div class="char-grid">
        {rendered.map(({ c, Content }) => (
          <article class="char-card card">
            {c.data.scene ? (
              <img class="scene" src={u(c.data.scene)} alt={`${c.data.name}, from Kim Rekowski’s drawing`} width="600" height="600" loading="lazy" />
            ) : c.data.portrait ? (
              <img class="portrait" src={u(c.data.portrait)} alt={`${c.data.name}, hand-drawn by Kim Rekowski`} width="320" height="416" loading="lazy" />
            ) : (
              <div class="portrait coming" aria-hidden="true">
                <Icon name="character-coming" size="5rem" />
              </div>
            )}
            <h3>{c.data.name}</h3>
            {c.data.role && <p class="role">{c.data.role}</p>}
            <div class="hello"><Content /></div>
            {!c.data.portrait && <p class="soon">Portrait coming soon — Kim's drawing is on its way!</p>}
          </article>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .note { color: var(--gg-ink-soft); margin-top: 6px; }
  .grit-grid {
    list-style: none; margin-top: 24px;
    display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 16px;
  }
  .grit-item {
    display: grid; gap: 8px; justify-items: center; text-align: center;
    padding: 22px 14px;
    font-family: var(--gg-display); font-weight: 500; color: var(--gg-blue);
  }
  .grit-emoji { display: grid; place-items: center; line-height: 0; }

  .char-grid {
    margin-top: 28px;
    display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 24px;
  }
  /* Like the homepage's doors: the art is square and sits flush at the top,
     the words get the padding. A card still on a cutout portrait keeps its
     old frame until its scene lands.

     The cards share one set of rows (subgrid): art, name, role, greeting,
     note. The tallest role in the row sets the role row for everyone, so
     every name sits on the same line across the row, every role starts
     level, and every quote opens level — a two-line role no longer shoves
     its own quote down while the neighbour's stays put. Before this the
     card's stretched rows also shared the leftover height out equally, so
     the shorter a card's words, the further its name drifted from its
     picture. Rows now pack to the top and the spacing is fixed margins:
     20 under the art, 6 between name and role, 14 before the quote. */
  .char-card {
    padding: 0 0 24px; overflow: hidden;
    display: grid; grid-row: span 5; grid-template-rows: subgrid;
    row-gap: 0; align-content: start; justify-items: start;
  }
  .char-card > * { padding-inline: 20px; }
  .char-card > .scene, .char-card > .portrait { grid-row: 1; }
  .char-card > h3 { grid-row: 2; margin-top: 20px; }
  .char-card > .role { grid-row: 3; margin-top: 6px; }
  .char-card > .hello { grid-row: 4; margin-top: 14px; }
  .char-card > .soon { grid-row: 5; margin-top: 12px; }
  .char-card > .portrait, .char-card > .portrait.coming { margin-top: 24px; }
  .char-card > .scene {
    padding: 0; width: 100%; height: auto; aspect-ratio: 1 / 1;
    object-fit: cover; display: block; background: var(--gg-sky);
  }
  .portrait {
    width: 100%; max-width: 220px; height: auto; margin-inline: auto;
    object-fit: contain;
  }
  .portrait.coming {
    aspect-ratio: 1; max-width: 180px;
    display: grid; place-items: center; font-size: 3rem;
    border: 3px dashed color-mix(in srgb, var(--gg-blue) 35%, transparent);
    border-radius: 50%;
    background: color-mix(in srgb, var(--gg-sky) 30%, #fff);
  }
  .role {
    font-size: 0.88rem; font-weight: 800; line-height: 1.35;
    color: var(--gg-green-ink); text-wrap: pretty;
  }
  .hello {
    font-family: var(--gg-hand); font-size: 1.3rem; line-height: 1.35;
    color: var(--gg-ink); text-wrap: pretty;
    /* the opening quote mark hangs in the margin so the words themselves
       line up with the name and role above */
    hanging-punctuation: first;
  }
  @supports not (hanging-punctuation: first) {
    .hello > :first-child { text-indent: -0.3em; }
  }
  .soon { font-size: 0.85rem; color: var(--gg-ink-soft); }
</style>
