---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { u } from '../lib/url';

const about = await getEntry('pages', 'about');
if (!about) throw new Error('src/content/pages/about.md is missing');
const { Content } = await render(about);
const { title, headshot, photo, photoCaption } = about.data;
---

<Base
  title="About Kim Rekowski — Growing with Gritty"
  description="Kim Rekowski is an elementary teacher, children's book author, and illustrator — creator of Gritty the Goat."
>
  <article>
    {/* Kim's own words lead, on the left and in the markup; the
        photograph of her at work hangs to their right — the one picture
        worth being big, saying teacher, author and illustrator without a
        caption. Her headshot is a byline next to her name, not a second
        contender. */}
    <section class="band hero-band">
      <div class="wrap hero">
        <div class="words">
          <p class="eyebrow">Teacher · Author · Illustrator</p>
          <h1>{title}</h1>
          {headshot && (
            <p class="byline">
              <img src={u(headshot)} alt="" width="270" height="270" loading="lazy" />
              <span>
                <b>Kim Rekowski</b>
                <span class="byline-role">Creator of Gritty the Goat</span>
              </span>
            </p>
          )}
          <div class="copy flow"><Content /></div>
        </div>
        {photo && (
          <figure class="portrait">
            <img
              src={u(photo)}
              alt="Kim Rekowski reading one of her books to a group of goats"
              width="683" height="856" fetchpriority="high"
            />
            {photoCaption && <figcaption>{photoCaption}</figcaption>}
          </figure>
        )}
      </div>
    </section>
  </article>
</Base>

<style>
  /* ── the hero: one large photograph, the title, and a byline ── */
  .hero-band { padding-bottom: 56px; }
  /* Start-aligned, not centred: the photograph is tall, and centring it
     would push the title itself below the fold. */
  .hero {
    display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: 36px 64px; align-items: start;
  }

  /* The photograph rides along as you read, so the long column of text
     never leaves a tall empty gutter beside it. */
  .portrait {
    position: sticky; top: 24px;
    margin: 0; padding: 14px 14px 10px;
    background: var(--gg-card); border-radius: var(--gg-radius);
    box-shadow: var(--gg-shadow-lift);
    rotate: 1.4deg; /* pinned to the wall, not pasted in — leaning away
                       from the words, the way it leaned away from them
                       when it hung on their other side */
  }
  .portrait img {
    display: block; width: 100%; height: auto;
    border-radius: var(--gg-radius-small);
  }
  .portrait figcaption {
    padding: 12px 6px 2px; text-align: center;
    font-family: var(--gg-hand); font-size: 1.15rem; line-height: 1.35;
    color: var(--gg-ink-soft);
  }

  .words { display: grid; gap: 14px; justify-items: start; }
  .words h1 { font-size: clamp(2.2rem, 5.4vw, 3.3rem); line-height: 1.03; }

  /* the headshot, at the size a byline actually needs */
  .byline {
    display: flex; align-items: center; gap: 18px; margin-top: 6px;
    padding: 10px 30px 10px 10px;
    background: var(--gg-card); border-radius: 999px;
    box-shadow: var(--gg-shadow);
  }
  .byline img {
    width: 124px; height: 124px; flex: none;
    border-radius: 50%; object-fit: cover;
    border: 4px solid var(--gg-gold);
  }
  .byline > span { display: grid; line-height: 1.3; }
  .byline b {
    font-family: var(--gg-display); font-weight: 600; font-size: 1.15rem;
    color: var(--gg-blue-deep);
  }
  .byline-role { font-size: var(--gg-text-small); color: var(--gg-ink-soft); }

  /* ── the writing ── */
  .copy { margin-top: 16px; max-width: 60ch; }
  .copy :global(h2) {
    margin-top: 1.5em; font-size: var(--gg-text-h2);
    color: var(--gg-blue-deep);
  }

  /* The motto is the point of the page — it gets to be the loudest thing
     on it. Kim writes it as a markdown quote, so the CMS quote button
     produces exactly this. */
  .copy :global(blockquote) {
    margin-block: 1.4em; padding: 26px 30px;
    background: var(--gg-card);
    border: 3px solid var(--gg-gold);
    border-radius: 8px 26px 8px 26px;
    box-shadow: var(--gg-shadow);
    rotate: -0.8deg;
  }
  .copy :global(blockquote p) {
    font-family: var(--gg-hand);
    font-size: clamp(1.7rem, 4.2vw, 2.3rem); line-height: 1.25;
    color: var(--gg-gold-ink); text-align: center; text-wrap: balance;
  }

  /* The sign-off, quieter than the motto but louder than the paragraphs.
     Direct children only: the blockquote's own <p> is also a :last-child,
     and it outranks the rule above if it can reach it. */
  .copy > :global(p:last-child) {
    margin-top: 1.3em; font-family: var(--gg-display); font-weight: 500;
    font-size: 1.2rem; color: var(--gg-green-ink); text-align: center;
  }

  @media (max-width: 820px) {
    .hero { grid-template-columns: 1fr; gap: 28px; }
    /* The photo still leads — order, since it now follows the words in
       the markup — but small enough that the title is on screen with it
       rather than a scroll below it. Sticky is a desktop idea. */
    .portrait {
      order: -1; position: static; max-width: 320px; justify-self: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .portrait, .copy :global(blockquote) { rotate: none; }
  }
</style>
