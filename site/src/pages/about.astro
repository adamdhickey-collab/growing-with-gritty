---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';

const about = await getEntry('pages', 'about');
if (!about) throw new Error('src/content/pages/about.md is missing');
const { Content } = await render(about);
const { title, headshot, photo, photoCaption } = about.data;
---

<Base
  title="About Kim Rekowski — Growing with Gritty"
  description="Kim Rekowski is an elementary teacher, children's book author, and illustrator — creator of Gritty the Goat."
>
  <section class="band">
    <div class="wrap grid">
      <div class="copy flow">
        <p class="eyebrow">Teacher · Author · Illustrator</p>
        <h1>{title}</h1>
        <Content />
      </div>
      <aside class="photos">
        {headshot && (
          <figure class="card">
            <img src={headshot} alt="Kim Rekowski" width="450" height="450" />
            <figcaption>Kim Rekowski</figcaption>
          </figure>
        )}
        {photo && (
          <figure class="card tilt">
            <img src={photo} alt="Kim Rekowski reading one of her books to a group of goats" width="550" height="688" loading="lazy" />
            {photoCaption && <figcaption>{photoCaption}</figcaption>}
          </figure>
        )}
      </aside>
    </div>
  </section>
</Base>

<style>
  .grid {
    display: grid; grid-template-columns: minmax(300px, 1.3fr) minmax(260px, 1fr);
    gap: 40px 64px; align-items: start;
  }
  .copy :global(h2) { margin-top: 1.4em; }
  .copy :global(blockquote) {
    font-family: var(--gg-hand); font-size: 1.5rem; color: var(--gg-blue);
    border-left: 4px solid var(--gg-gold); padding-left: 18px; margin-block: 0.6em;
  }
  .photos { display: grid; gap: 28px; }
  .photos figure { padding: 14px 14px 12px; }
  .photos img { display: block; width: 100%; border-radius: var(--gg-radius-small); }
  .photos figcaption {
    padding-top: 10px; text-align: center;
    font-family: var(--gg-hand); font-size: 1.15rem; color: var(--gg-ink-soft);
  }
  .tilt { transform: rotate(1.2deg); }
  @media (max-width: 760px) {
    .grid { grid-template-columns: 1fr; }
  }
</style>
