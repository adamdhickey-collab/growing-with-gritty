---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Bubble from '../components/Bubble.astro';
import BookCard from '../components/BookCard.astro';
import MeadowHero from '../components/MeadowHero.astro';
import Stamp from '../components/Stamp.astro';
import home from '../data/homepage.json';
import { u } from '../lib/url';

const books = (await getCollection('books')).sort((a, b) => a.data.order - b.data.order);
---

<Base
  title="Growing with Gritty"
  description="Stories and activities that help kids build grit, kindness, and confidence — with Gritty the Goat, by teacher and author Kim Rekowski."
>
  <MeadowHero
    heading={home.heroHeading}
    bubble={home.heroBubble}
    sayings={home.heroSayings}
  />

  <section class="band welcome">
    <div class="wrap welcome-inner">
      <img
        class="welcome-art"
        src={u("/images/scenes/gritty-backpack.webp")}
        alt="Gritty the Goat wearing a blue backpack, ready for school"
        width="600" height="576" loading="lazy"
      />
      <div class="welcome-copy">
        <p class="lede">{home.heroText}</p>
        <p class="tagline">{home.heroTagline}</p>
        <div class="cta">
          <a class="btn btn-primary" href={u("/meet-gritty")}>🐐 Meet Gritty</a>
          <a class="btn btn-gold" href={u("/books")}>📚 See the books</a>
        </div>
      </div>
    </div>
  </section>

  <section class="band" aria-label="Gritty's four values">
    <div class="wrap stamps">
      <Stamp emoji="🌱" label="Be Determined" tone="green" tilt={-3} />
      <Stamp emoji="💛" label="Be Kind" tone="gold" tilt={2} />
      <Stamp emoji="⭐" label="Believe in Yourself" tone="blue" tilt={-2} />
      <Stamp emoji="⛰️" label="Never Give Up" tone="green" tilt={3} />
    </div>
  </section>

  <section class="band band-sky">
    <div class="wrap">
      <p class="eyebrow">Books by Kim Rekowski</p>
      <h2>Four adventures, one big idea: keep trying</h2>
      <div class="book-grid">
        {books.map((book) => <BookCard book={book} />)}
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="world-h">
    <div class="wrap">
      <p class="eyebrow">Gritty's World</p>
      <h2 id="world-h">Where do you want to go?</h2>
      <p class="world-note">Games and quiet corners for practicing grit —
      everything happens right on your device.</p>
      <div class="world-grid">
        <a class="world-card card" href={u("/books")}>
          <img src={u("/images/scenes/gritty-reading.webp")}
               alt="" width="600" height="600" loading="lazy" />
          <h3>Read</h3>
          <p>Look inside all four books, then find your favorite.</p>
        </a>
        <a class="world-card card" href={u("/grit-zone")}>
          <img src={u("/images/scenes/gritty-building-blocks.webp")}
               alt="" width="600" height="600" loading="lazy" />
          <h3>Play</h3>
          <p>Help Gritty choose what grit looks like — then feel the Power
          of YET!</p>
        </a>
        <a class="world-card card" href={u("/grown-ups")}>
          <img src={u("/images/scenes/gritty-coloring.webp")}
               alt="" width="600" height="600" loading="lazy" />
          <h3>Make</h3>
          <p>Coloring sheets and bookmarks to print at home.</p>
        </a>
        <a class="world-card card" href={u("/calm-corner")}>
          <img src={u("/images/scenes/gritty-calm.webp")}
               alt="" width="600" height="600" loading="lazy" />
          <h3>Calm Corner</h3>
          <p>Pick a feeling, find a calm-down idea, and breathe with
          Gritty.</p>
        </a>
      </div>
      <p class="world-more">
        Made a mistake today? Lucky you —
        <a href={u("/mistake-maker")}>visit the Mistake Maker 🧠</a>
      </p>
    </div>
  </section>

  <section class="band">
    <div class="wrap grown-cta card">
      <div>
        <p class="eyebrow">For parents &amp; teachers</p>
        <h2>The Grown-Up Grit Guide</h2>
        <p>Free printables, conversation starters, and classroom ideas for
        talking about grit, mistakes, and big feelings — straight from Kim's
        classroom.</p>
      </div>
      <a class="btn btn-primary" href={u("/grown-ups")}>Visit the guide</a>
    </div>
  </section>

  <section class="band" aria-label="A reminder from Gritty">
    <div class="wrap reminder">
      <Bubble variant="cheer" tail={false}>{home.reminder}</Bubble>
    </div>
  </section>
</Base>

<style>
  .welcome { padding-block: 44px; }
  .welcome-inner {
    display: grid; grid-template-columns: minmax(0, 230px) minmax(0, 1fr);
    gap: 12px 40px; align-items: center; justify-content: center;
  }
  .welcome-art { width: 100%; height: auto; display: block; }
  .welcome-copy { display: grid; gap: 18px; justify-items: start; }
  .lede { font-size: 1.15rem; color: var(--gg-ink-soft); max-width: 52ch; }
  .tagline {
    font-family: var(--gg-display); font-weight: 600; font-size: 1.35rem;
    color: var(--gg-green-ink); max-width: 20ch;
  }
  .cta { display: flex; flex-wrap: wrap; gap: 14px; }

  @media (max-width: 700px) {
    .welcome-inner {
      grid-template-columns: 1fr; justify-items: center; text-align: center;
    }
    .welcome-art { max-width: 220px; }
    .welcome-copy { justify-items: center; }
    .tagline { max-width: none; }
    .cta { justify-content: center; }
  }

  .stamps { display: flex; flex-wrap: wrap; gap: 24px 40px; justify-content: center; }

  .book-grid {
    margin-top: 28px;
    display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 24px;
  }

  .world-note { color: var(--gg-ink-soft); margin-top: 6px; }
  .world-grid {
    margin-top: 24px;
    display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 20px;
  }
  .world-card {
    padding: 0 0 26px; display: grid; gap: 10px; justify-items: start;
    text-decoration: none; color: var(--gg-ink); overflow: hidden;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .world-card:hover { transform: translateY(-3px); box-shadow: var(--gg-shadow-lift); color: var(--gg-ink); }
  .world-card > * { padding-inline: 26px; }
  /* Kim's scene art is the button — square, sitting flush at the top */
  .world-card img {
    padding: 0; width: 100%; height: auto; aspect-ratio: 1 / 1;
    object-fit: cover; display: block; background: var(--gg-sky);
  }
  .world-card h3 { margin-top: 18px; }
  .world-card p { color: var(--gg-ink-soft); }

  .world-more { margin-top: 22px; color: var(--gg-ink-soft); }

  .grown-cta {
    display: flex; flex-wrap: wrap; align-items: center; gap: 20px 40px;
    padding: 36px 40px;
  }
  .grown-cta > div { flex: 1; min-width: 260px; display: grid; gap: 10px; }
  .grown-cta .btn { flex: none; }

  .reminder { display: flex; justify-content: center; }
</style>
