---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import BookCard from '../components/BookCard.astro';
import MeadowHero from '../components/MeadowHero.astro';
import home from '../data/homepage.json';
import Icon from '../components/Icon.astro';
import { u } from '../lib/url';

const books = (await getCollection('books')).sort((a, b) => a.data.order - b.data.order);
---

<Base
  title="Growing with Gritty"
  description="Stories and activities that help kids build grit, kindness, and confidence — with Gritty the Goat, by teacher and author Kim Rekowski."
>
  <MeadowHero
    heading={home.heroHeading}
    bubble={home.heroBubble}
    sayings={home.heroSayings}
  />

  <section class="band welcome">
    <div class="wrap welcome-inner">
      <h2 class="tagline">{home.heroTagline}</h2>
      <p class="lede">{home.heroText}</p>
      <div class="cta">
        <a class="btn btn-primary cta-big" href={u("/meet-gritty")}>
          <img src={u("/images/nav/meet-gritty.webp")} alt="" width="64" height="64" />
          <span>Meet Gritty</span>
        </a>
        {/* on the sunshine band a gold button would melt into the sky —
            and white-on-gold text never met AA anyway (≈2.2:1). A white
            paper button with Gritty Blue does both jobs. */}
        <a class="btn btn-ghost cta-big" href={u("/books")}>
          <img src={u("/images/nav/books.webp")} alt="" width="64" height="64" />
          <span>See the books</span>
        </a>
      </div>
    </div>
  </section>

  <section class="band band-world" aria-labelledby="world-h">
    <div class="wrap">
      <p class="eyebrow">Gritty's World</p>
      <h2 id="world-h">Where do you want to go?</h2>
      <p class="world-note">Games and quiet corners for practicing grit —
      everything happens right on your device.</p>
      <div class="world-grid">
        <a class="world-card card" href={u("/books")}>
          <img src={u("/images/scenes/gritty-reading.webp")}
               alt="" width="600" height="600" loading="lazy" />
          <h3>Read</h3>
          <p>Look inside all four books, then find your favorite.</p>
        </a>
        <a class="world-card card" href={u("/grit-zone")}>
          <img src={u("/images/scenes/gritty-climbing.webp")}
               alt="" width="600" height="600" loading="lazy" />
          <h3>Play</h3>
          <p>Help Gritty choose what grit looks like — then feel the Power
          of YET!</p>
        </a>
        <a class="world-card card" href={u("/grown-ups")}>
          <img src={u("/images/scenes/gritty-coloring.webp")}
               alt="" width="600" height="600" loading="lazy" />
          <h3>Make</h3>
          <p>Coloring sheets and bookmarks to print at home.</p>
        </a>
        <a class="world-card card" href={u("/calming-corner")}>
          <img src={u("/images/scenes/gritty-calm.webp")}
               alt="" width="600" height="600" loading="lazy" />
          <h3>Breathe</h3>
          <p>Pick a feeling, find a calm-down idea, and breathe with
          Gritty.</p>
        </a>
      </div>
      {/* Not a footnote. The Mistake Maker is one of the five things this
          site is for, and it was a grey sentence under four illustrated
          doors. It takes the strip every other room uses to hand a reader
          on — its own weight, without making the four-door grid a
          five-door one. */}
      <div class="world-more card">
        <p>Made a mistake today? Lucky you — mistakes are how brains grow.</p>
        <a class="btn btn-primary" href={u("/mistake-maker")}>
          <Icon name="action-brain-grows" /> Visit the Mistake Maker
        </a>
      </div>
    </div>
  </section>

  <section class="band band-sky">
    <div class="wrap">
      <p class="eyebrow">Books by Kim Rekowski</p>
      <h2>Four adventures, one big idea: keep trying</h2>
      <div class="book-grid">
        {books.map((book) => <BookCard book={book} />)}
      </div>
    </div>
  </section>

  <section class="band band-grown">
    <div class="wrap grown-cta card">
      <div>
        <p class="eyebrow">For parents &amp; teachers</p>
        <h2>The Grown-Up Grit Guide</h2>
        <p>Free printables, conversation starters, and classroom ideas for
        talking about grit, mistakes, and big feelings — straight from Kim's
        classroom.</p>
      </div>
      <a class="btn btn-primary" href={u("/grown-ups")}>Visit the guide</a>
    </div>
  </section>
</Base>

<style>
  /* ── the welcome: words only — Gritty already made his entrance in the
     hero, so this section speaks up instead of repeating him. It sits in
     full sunshine: the meadow's own yellows, light at the grass line and
     warming as it goes. Every color on the sun re-checked for AA —
     blue-deep ≈ 7.5:1, ink ≈ 10:1; green-ink and ink-soft (the paper-band
     colors) drop to ≈ 4.4:1 here, which is why they don't come along. ── */
  .welcome {
    padding-block: 52px 48px;
    background: linear-gradient(180deg, var(--gg-sun-core), var(--gg-sun));
  }
  .welcome-inner {
    display: grid; gap: 20px; justify-items: center; text-align: center;
  }
  .tagline {
    font-family: var(--gg-display); font-weight: 600;
    font-size: clamp(1.7rem, 3.6vw, 2.4rem); line-height: 1.15;
    color: var(--gg-blue-deep); text-wrap: balance;
  }
  .lede {
    font-size: clamp(1.15rem, 1.8vw, 1.35rem); line-height: 1.6;
    color: var(--gg-ink); max-width: 54ch; text-wrap: pretty;
  }
  .cta { display: flex; flex-wrap: wrap; gap: 18px; justify-content: center; margin-top: 6px; }
  /* the books button: white paper so it pops off the sun, Gritty Blue
     text at ≈ 6.7:1 (the global ghost is see-through, which on yellow
     would tint it green) */
  .welcome .btn-ghost { background: #fff; }
  .welcome .btn-ghost:hover { background: color-mix(in srgb, var(--gg-sky) 35%, #fff); }
  /* the gold focus ring vanishes on its own color (≈1.8:1) — on this band
     the ring goes deep blue (≈8:1, WCAG 1.4.11 wants 3:1) */
  .welcome :focus-visible { outline-color: var(--gg-blue-deep); }
  /* the crayon nav icons, at a size where the drawing actually reads */
  .cta-big {
    display: inline-flex; align-items: center; gap: 13px;
    font-size: 1.2rem; padding: 10px 30px 10px 14px;
  }
  .cta-big img {
    width: 52px; height: 52px; object-fit: contain;
    background: #fff; border-radius: 50%; padding: 5px;
  }

  .book-grid {
    margin-top: 28px;
    display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 24px;
  }

  /* ── the world band: a clean sheet of paper. The cards themselves are
     Kim's art — on a quiet ground they do all the talking. ── */
  .band-world { padding-block: 56px 76px; }

  .world-note { color: var(--gg-ink-soft); margin-top: 6px; }
  .world-grid {
    margin-top: 24px;
    display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 20px;
  }
  .world-card {
    padding: 0 0 26px; display: grid; gap: 10px; justify-items: start;
    text-decoration: none; color: var(--gg-ink); overflow: hidden;
    transition: transform var(--gg-dur-tap) ease, box-shadow var(--gg-dur-tap) ease;
  }
  @media (hover: hover) {
    .world-card:hover { transform: translateY(-3px); box-shadow: var(--gg-shadow-lift); color: var(--gg-ink); }
  }
  /* the four doors are how a child on a tablet gets anywhere, and a
     tablet never hovers: the press is their only confirmation */
  .world-card:active { transform: translateY(1px); box-shadow: var(--gg-shadow-press); }
  .world-card > * { padding-inline: 26px; }
  /* Kim's scene art is the button — square, sitting flush at the top */
  .world-card img {
    padding: 0; width: 100%; height: auto; aspect-ratio: 1 / 1;
    object-fit: cover; display: block; background: var(--gg-sky);
  }
  .world-card h3 { margin-top: 18px; }
  .world-card p { color: var(--gg-ink-soft); }

  .world-more {
    margin-top: 26px;
    display: flex; flex-wrap: wrap; align-items: center; gap: 16px 32px;
    padding: 28px 36px;
  }
  .world-more p { flex: 1; min-width: 240px; }
  /* The closing strips elsewhere ARE the .wrap, so they get its full width;
     this one is nested inside a .wrap and so has 48px less to work with —
     enough that a `flex: none` button ran 2px off a 320px screen. It is
     allowed to shrink and wrap its label instead; the 48px tap floor comes
     from min-height, so a two-line button is still a legal target. */
  .world-more .btn { flex: 0 1 auto; }
  @media (max-width: 420px) { .world-more { padding: 22px 20px; } }

  /* ── the grown-ups band: the page's third ground. Sky belongs to the
     books above and gold to the welcome, and another sheet of paper-deep
     would read as the same tan the whole page already sits on — so this
     one is a Meadow Green wash, the growing color, mixed light enough
     that the white card still lifts off it. ── */
  .band-grown {
    background: color-mix(in srgb, var(--gg-green) 22%, var(--gg-paper));
    margin-bottom: 0; /* its own ground — it meets the footer, no paper between */
  }

  .grown-cta {
    display: flex; flex-wrap: wrap; align-items: center; gap: 20px 40px;
    padding: 36px 40px;
  }
  .grown-cta > div { flex: 1; min-width: 260px; display: grid; gap: 10px; }
  .grown-cta .btn { flex: none; }

</style>
