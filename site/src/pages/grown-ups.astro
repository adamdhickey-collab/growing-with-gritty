---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { u } from '../lib/url';
import { buyLabel } from '../lib/buy';

const printables = await getCollection('printables');

/* The books behind the guide — only ones with a buy link, in series order. */
const buyableBooks = (await getCollection('books'))
  .filter((b) => b.data.buyLink)
  .sort((a, b) => a.data.order - b.data.order);

/* Every kind maps to an icon; there is no emoji fallback and never was,
   so the type does not offer one. */
const kindLabels: Record<string, { icon?: string; label: string }> = {
  'coloring-page': { icon: 'printable-coloring-page', label: 'Coloring page' },
  'discussion-cards': { icon: 'printable-discussion-cards', label: 'Discussion cards' },
  'calm-down-cards': { icon: 'action-calm-break', label: 'Calm-down cards' },
  'poster': { icon: 'badge-star-burst', label: 'Poster' },
  'journal': { icon: 'printable-journal', label: 'Grit journal' },
  'certificate': { icon: 'printable-certificate', label: 'Certificate' },
  'book-guide': { icon: 'printable-book-guide', label: 'Book guide' },
  'classroom-activity': { icon: 'printable-classroom', label: 'Classroom activity' },
};

/* Each group carries its own ground, so four sections of downloads don't
   stack into one long block. The ground belongs to the audience, not to
   the position, so a group keeps its colour as printables arrive and empty
   groups drop out — and any two of these four still read apart if the one
   between them is missing. */
const groups = [
  { audience: 'kids', heading: 'For kids', ground: 'band-sky-flat', blurb: 'Coloring pages and activities to print at home.' },
  { audience: 'parents', heading: 'For parents', ground: 'band-meadow', blurb: 'Conversation starters and at-home grit ideas.' },
  { audience: 'teachers', heading: 'For teachers', ground: 'band-gold', blurb: 'Classroom activities and discussion guides from Kim’s own classroom.' },
  { audience: 'everyone', heading: 'For everyone', ground: 'band-blush', blurb: 'Posters, certificates, and more.' },
].map((g) => ({ ...g, items: printables.filter((p) => p.data.audience === g.audience) }))
 .filter((g) => g.items.length > 0);
---

<Base
  title="Grown-Up Grit Guide — Growing with Gritty"
  description="Free printables, conversation starters, and classroom ideas for parents and teachers, from teacher and author Kim Rekowski."
>
  <section class="band intro">
    <div class="wrap flow">
      <p class="eyebrow">For parents &amp; teachers</p>
      <h1>The Grown-Up Grit Guide</h1>
      <p class="lede">Kim is an elementary teacher first — these are the same
      kinds of materials she uses in her own classroom to talk about grit,
      mistakes, kindness, and big feelings. Everything here is free to
      download and print.</p>
      <p class="print-note"><Icon name="ui-download" /> Every download is a
      one-page PDF set up for US Letter paper, with a half-inch margin so a
      home printer can't clip the edges. Black and white — no color ink
      needed.</p>
    </div>
  </section>

  {groups.length === 0 ? (
    <section class="band band-sky-flat">
      <div class="wrap empty card">
        <span class="big" aria-hidden="true"><Icon name="printable-coloring-page" size="4.5rem" /></span>
        <h2>The first printables are on their way!</h2>
        <p>Kim is getting her coloring pages, discussion cards, and posters
        ready right now. Check back soon — or
        <a href={u("/books")}>meet the books</a> while you wait.</p>
      </div>
    </section>
  ) : (
    groups.map((g) => (
      <section class={`band ${g.ground}`}>
        <div class="wrap">
          <h2>{g.heading}</h2>
          <p class="blurb">{g.blurb}</p>
          <ul class="dl-grid" role="list">
            {g.items.map((p) => (
              <li class="dl card">
                {p.data.thumb && (
                  /* The picture saves the sheet too, because people tap the
                     picture. It's hidden from screen readers and out of the
                     tab order so the button below stays the one link to it. */
                  <a class="sheet" href={u(p.data.download)} download tabindex="-1" aria-hidden="true">
                    <img src={u(p.data.thumb)} alt="" width="560" height="725" loading="lazy" />
                  </a>
                )}
                <h3>{p.data.title}</h3>
                {p.data.blurb && <p class="dl-blurb">{p.data.blurb}</p>}
                <p class="kind">
                  {kindLabels[p.data.kind]?.icon && <Icon name={kindLabels[p.data.kind].icon!} />}
                  {kindLabels[p.data.kind]?.label ?? p.data.kind}
                  <span class="spec">PDF &middot; US&nbsp;Letter &middot; 1&nbsp;page</span>
                </p>
                {/* Every card's button reads "Download & print", so the
                    label carries which sheet — a screen reader listing the
                    links otherwise hears the same words three times. */}
                <a class="btn btn-primary" href={u(p.data.download)} download
                   aria-label={`Download and print: ${p.data.title} (PDF, US Letter, 1 page)`}>
                  <Icon name="ui-download" /> Download &amp; print
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    ))
  )}

  <section class="band band-deep">
    <div class="wrap flow">
      <h2>Why "grit"?</h2>
      <p>Through Gritty and his friends, kids practice naming what grit looks
      like: trying something hard, keeping going, trying a new idea, asking
      for help, trying again, and believing in yourself. The books give you a
      shared character — <em>"What would Gritty do?"</em> — that makes those
      conversations easy to start at the dinner table or on the rug.</p>
      <p>Every activity on this site happens right on your child's device —
      the site collects no names, no accounts, and no personal information.</p>
    </div>
  </section>

  {buyableBooks.length > 0 && (
    <section class="band band-gold" aria-labelledby="own-h">
      <div class="wrap own card">
        <div class="own-copy">
          <p class="eyebrow"><Icon name="printable-book-guide" /> Bring Gritty home</p>
          <h2 id="own-h">The books behind the guide</h2>
          <p>Every printable and conversation starter here grows out of one of
          Kim's four books. Tap a cover to get your copy on Amazon — or
          <a href={u("/books")}>look inside the books</a> first.</p>
        </div>
        <ul class="own-books" role="list">
          {buyableBooks.map((b) => (
            <li>
              <a href={b.data.buyLink} target="_blank" rel="noopener"
                 aria-label={`${buyLabel(b.data.buyLink!)}: ${b.data.title} (opens in a new tab)`}>
                <img src={u(b.data.cover)} alt="" width="160" height="160" loading="lazy" />
                <span>{b.data.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}
</Base>

<style>
  .lede { font-size: 1.12rem; color: var(--gg-ink-soft); }
  /* The intro used to give up its bottom padding, because it and the band
     under it shared plain paper and their two 56px paddings read as a
     canyon. Every band under it now has a ground of its own, so that air
     is no longer one gap — it's the foot of one room and the head of the
     next, and each keeps its own. */
  .empty {
    display: grid; gap: 12px; justify-items: center; text-align: center;
    padding: 48px 32px;
  }
  .empty .big { display: grid; place-items: center; line-height: 0; }
  .empty p { color: var(--gg-ink-soft); }
  .blurb { color: var(--gg-ink-soft); margin-top: 4px; }
  .dl-grid {
    list-style: none; margin-top: 20px;
    /* Wider than the other grids on the site: these cards carry a portrait
       sheet of paper, and a narrow column makes the preview too small to
       tell one coloring page from another. */
    display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 20px;
  }
  .print-note {
    display: flex; gap: 0.6em; align-items: baseline;
    max-width: 62ch; color: var(--gg-ink-soft); font-size: var(--gg-text-small);
  }
  .dl { padding: 20px; display: grid; gap: 10px; justify-items: stretch; }
  .dl h3 { margin-top: 4px; }
  /* The preview is a photograph of the printed page, so it gets to look
     like paper: white to the edge, a hairline, and a shadow that says
     "sheet" rather than "picture". */
  .sheet {
    display: block; background: var(--gg-card);
    border: 1px solid rgba(42, 50, 56, 0.14);
    border-radius: var(--gg-radius-small);
    box-shadow: var(--gg-shadow);
    overflow: hidden;
    transition: transform var(--gg-dur-tap) ease, box-shadow var(--gg-dur-tap) ease;
  }
  .sheet img { display: block; width: 100%; height: auto; }
  /* The whole card is the hover target: the sheet lifts wherever a grown-up
     is pointing, including at the button. */
  @media (hover: hover) {
    .dl:hover .sheet { transform: translateY(-3px); box-shadow: var(--gg-shadow-lift); }
  }
  .dl:active .sheet { transform: translateY(1px); box-shadow: var(--gg-shadow-press); }
  .dl-blurb { color: var(--gg-ink-soft); font-size: var(--gg-text-small); margin-top: -2px; }
  .kind {
    font-size: var(--gg-text-small); font-weight: 800; color: var(--gg-green-ink);
    display: flex; align-items: center; gap: 0.4em; flex-wrap: wrap;
  }
  /* What you actually get. It takes the whole line rather than trailing the
     kind, because at one card wide it wraps either way — and a separator
     that wraps with it dangles at the start of the new line. */
  .kind .spec {
    flex: 1 0 100%;
    color: var(--gg-ink-soft); font-weight: 700; letter-spacing: 0.01em;
  }
  .dl .btn { justify-self: start; margin-top: 2px; }

  /* — bring Gritty home — */
  .own { padding: 36px 40px; display: grid; gap: 24px; }
  .own-copy { display: grid; gap: 10px; max-width: 62ch; }
  .own-copy p { color: var(--gg-ink-soft); }
  .own-books {
    list-style: none;
    display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    gap: 18px;
  }
  .own-books a {
    display: grid; gap: 8px; justify-items: center; text-align: center;
    text-decoration: none;
    font-family: var(--gg-display); font-weight: 500;
    font-size: 0.95rem; line-height: 1.3;
  }
  .own-books img {
    width: 100%; max-width: 160px; height: auto;
    border-radius: var(--gg-radius-small);
    box-shadow: var(--gg-shadow);
    transition: transform var(--gg-dur-tap) ease, box-shadow var(--gg-dur-tap) ease;
  }
  @media (hover: hover) {
    .own-books a:hover img { transform: translateY(-3px) rotate(-0.6deg); box-shadow: var(--gg-shadow-lift); }
  }
  .own-books a:active img { transform: translateY(1px); box-shadow: var(--gg-shadow-press); }
  .own-books a:hover span { text-decoration: underline; text-decoration-thickness: 2px; }
</style>
