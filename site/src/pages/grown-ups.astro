---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { u } from '../lib/url';
import { buyLabel } from '../lib/buy';

const printables = await getCollection('printables');

/* The books behind the guide — only ones with a buy link, in series order. */
const buyableBooks = (await getCollection('books'))
  .filter((b) => b.data.buyLink)
  .sort((a, b) => a.data.order - b.data.order);

const kindLabels: Record<string, { icon?: string; emoji?: string; label: string }> = {
  'coloring-page': { icon: 'printable-coloring-page', label: 'Coloring page' },
  'discussion-cards': { icon: 'printable-discussion-cards', label: 'Discussion cards' },
  'calm-down-cards': { icon: 'action-calm-break', label: 'Calm-down cards' },
  'poster': { icon: 'badge-star-burst', label: 'Poster' },
  'journal': { icon: 'printable-journal', label: 'Grit journal' },
  'certificate': { icon: 'printable-certificate', label: 'Certificate' },
  'book-guide': { icon: 'printable-book-guide', label: 'Book guide' },
  'classroom-activity': { icon: 'printable-classroom', label: 'Classroom activity' },
};

const groups = [
  { audience: 'kids', heading: 'For kids', blurb: 'Coloring pages and activities to print at home.' },
  { audience: 'parents', heading: 'For parents', blurb: 'Conversation starters and at-home grit ideas.' },
  { audience: 'teachers', heading: 'For teachers', blurb: 'Classroom activities and discussion guides from Kim’s own classroom.' },
  { audience: 'everyone', heading: 'For everyone', blurb: 'Posters, certificates, and more.' },
].map((g) => ({ ...g, items: printables.filter((p) => p.data.audience === g.audience) }))
 .filter((g) => g.items.length > 0);
---

<Base
  title="Grown-Up Grit Guide — Growing with Gritty"
  description="Free printables, conversation starters, and classroom ideas for parents and teachers, from teacher and author Kim Rekowski."
>
  <section class="band">
    <div class="wrap flow">
      <p class="eyebrow">For parents &amp; teachers</p>
      <h1>The Grown-Up Grit Guide</h1>
      <p class="lede">Kim is an elementary teacher first — these are the same
      kinds of materials she uses in her own classroom to talk about grit,
      mistakes, kindness, and big feelings. Everything here is free to
      download and print.</p>
    </div>
  </section>

  {groups.length === 0 ? (
    <section class="band">
      <div class="wrap empty card">
        <span class="big" aria-hidden="true"><Icon name="printable-coloring-page" size="4.5rem" /></span>
        <h2>The first printables are on their way!</h2>
        <p>Kim is getting her coloring pages, discussion cards, and posters
        ready right now. Check back soon — or
        <a href={u("/books")}>meet the books</a> while you wait.</p>
      </div>
    </section>
  ) : (
    groups.map((g) => (
      <section class="band">
        <div class="wrap">
          <h2>{g.heading}</h2>
          <p class="blurb">{g.blurb}</p>
          <ul class="dl-grid" role="list">
            {g.items.map((p) => (
              <li class="dl card">
                {p.data.thumb && <img src={u(p.data.thumb)} alt="" width="280" height="200" loading="lazy" />}
                <h3>{p.data.title}</h3>
                <p class="kind">
                  {kindLabels[p.data.kind]?.icon && <Icon name={kindLabels[p.data.kind].icon!} />}
                  {kindLabels[p.data.kind]?.emoji}
                  {kindLabels[p.data.kind]?.label ?? p.data.kind}
                </p>
                <a class="btn btn-primary" href={u(p.data.download)}><Icon name="ui-download" /> Download PDF</a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    ))
  )}

  <section class="band band-deep">
    <div class="wrap flow">
      <h2>Why "grit"?</h2>
      <p>Through Gritty and his friends, kids practice naming what grit looks
      like: trying something hard, keeping going, trying a new idea, asking
      for help, trying again, and believing in yourself. The books give you a
      shared character — <em>"What would Gritty do?"</em> — that makes those
      conversations easy to start at the dinner table or on the rug.</p>
      <p>Every activity on this site happens right on your child's device —
      the site collects no names, no accounts, and no personal information.</p>
    </div>
  </section>

  {buyableBooks.length > 0 && (
    <section class="band" aria-labelledby="own-h">
      <div class="wrap own card">
        <div class="own-copy">
          <p class="eyebrow"><Icon name="printable-book-guide" /> Bring Gritty home</p>
          <h2 id="own-h">The books behind the guide</h2>
          <p>Every printable and conversation starter here grows out of one of
          Kim's four books. Tap a cover to get your copy on Amazon — or
          <a href={u("/books")}>look inside the books</a> first.</p>
        </div>
        <ul class="own-books" role="list">
          {buyableBooks.map((b) => (
            <li>
              <a href={b.data.buyLink} target="_blank" rel="noopener"
                 aria-label={`${buyLabel(b.data.buyLink!)}: ${b.data.title} (opens in a new tab)`}>
                <img src={u(b.data.cover)} alt="" width="160" height="160" loading="lazy" />
                <span>{b.data.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}
</Base>

<style>
  .lede { font-size: 1.12rem; color: var(--gg-ink-soft); }
  .empty {
    display: grid; gap: 12px; justify-items: center; text-align: center;
    padding: 48px 32px;
  }
  .empty .big { display: grid; place-items: center; line-height: 0; }
  .empty p { color: var(--gg-ink-soft); }
  .blurb { color: var(--gg-ink-soft); margin-top: 4px; }
  .dl-grid {
    list-style: none; margin-top: 20px;
    display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 20px;
  }
  .dl { padding: 20px; display: grid; gap: 10px; justify-items: start; }
  .dl img { border-radius: var(--gg-radius-small); }
  .kind {
    font-size: 0.88rem; font-weight: 800; color: var(--gg-green-ink);
    display: flex; align-items: center; gap: 0.4em;
  }

  /* — bring Gritty home — */
  .own { padding: 36px 40px; display: grid; gap: 24px; }
  .own-copy { display: grid; gap: 10px; max-width: 62ch; }
  .own-copy p { color: var(--gg-ink-soft); }
  .own-books {
    list-style: none;
    display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    gap: 18px;
  }
  .own-books a {
    display: grid; gap: 8px; justify-items: center; text-align: center;
    text-decoration: none;
    font-family: var(--gg-display); font-weight: 500;
    font-size: 0.95rem; line-height: 1.3;
  }
  .own-books img {
    width: 100%; max-width: 160px; height: auto;
    border-radius: var(--gg-radius-small);
    box-shadow: var(--gg-shadow);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .own-books a:hover img { transform: translateY(-3px) rotate(-0.6deg); box-shadow: var(--gg-shadow-lift); }
  .own-books a:hover span { text-decoration: underline; text-decoration-thickness: 2px; }
</style>
