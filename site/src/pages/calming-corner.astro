---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Bubble from '../components/Bubble.astro';
import GrittyHero from '../components/GrittyHero.astro';
import Icon from '../components/Icon.astro';
import { u } from '../lib/url';

const strategies = (await getCollection('calm-strategies')).sort((a, b) => a.data.order - b.data.order);

/* The feeling picker is fixed vocabulary (from Kim's doc), not CMS content —
   each answer is Gritty naming the feeling as okay before offering calm. */
const feelings = [
  { icon: 'feeling-angry', label: 'Angry', response: "It's okay to feel angry. Anger means something felt unfair. Let's help your body cool down." },
  { icon: 'feeling-sad', label: 'Sad', response: "It's okay to feel sad. Even goats have rainy days. Let's be extra gentle with ourselves." },
  { icon: 'feeling-worried', label: 'Worried', response: "It's okay to feel worried. Worries get smaller after a slow breath. Want to try one together?" },
  { icon: 'feeling-frustrated', label: 'Frustrated', response: "It's okay to feel frustrated. That means you're doing something HARD — and hard things take grit." },
  { icon: 'feeling-tired', label: 'Tired', response: "It's okay to feel tired. Bodies and brains need rest to grow. Let's find a slow, quiet calm-down." },
  { icon: 'feeling-nervous', label: 'Nervous', response: "It's okay to feel nervous. Nervous and excited are almost the same wiggle! A slow breath helps both." },
];
---

<Base
  title="The Calming Corner — Growing with Gritty"
  description="Pick the face that matches your feeling, choose a calm-down strategy, and breathe along with Gritty the Goat. Big feelings happen to everyone."
>
  <section class="band hero-rose">
    <GrittyHero eyebrow="Gritty's World">
      <Fragment slot="title">The Calming Corner <Icon name="action-calm-break" size="1.1em" /></Fragment>
      <Fragment slot="quote">
        "Big feelings happen to everyone. Let's help your body feel calm."
      </Fragment>
    </GrittyHero>
  </section>

  <section class="band band-sky" aria-labelledby="feel-h">
    <div class="wrap feel-wrap">
      <h2 id="feel-h">How are you feeling?</h2>
      <div class="feelings" role="group" aria-label="Pick a feeling">
        {feelings.map((f) => (
          <button
            type="button"
            class="feeling"
            data-feeling
            data-response={f.response}
            aria-pressed="false"
          >
            <Icon name={f.icon} size="3.6rem" />
            <span>{f.label}</span>
          </button>
        ))}
      </div>
      <div class="feel-answer">
        <span class="stand">
          <img
            class="feel-gritty"
            src={u("/images/characters/gritty-standing-right.webp")}
            alt="" aria-hidden="true"
            width="878" height="1097" loading="lazy"
          />
        </span>
        <Bubble>
          <span data-feel-response role="status">Every feeling is okay to
          have. Pick the face that matches yours — or head straight to a
          calm-down idea below.</span>
        </Bubble>
      </div>
    </div>
  </section>

  <section class="band band-blush" aria-labelledby="ideas-h">
    <div class="wrap">
      <h2 id="ideas-h">Pick a calm-down idea</h2>
      <p class="note">Tap one to see how it works. They all work for every
      feeling — pick whichever sounds good right now.</p>
      <div class="strategies">
        {strategies.map((s) => (
          <details class="strategy card">
            <summary>
              {s.data.icon
                ? <Icon name={s.data.icon} size="3rem" />
                : s.data.emoji
                  ? <span class="strat-emoji" aria-hidden="true">{s.data.emoji}</span>
                  : <Icon name="calm-leaf" size="2.1rem" />}
              <span class="strat-name">{s.data.name}</span>
              <span class="strat-chevron" aria-hidden="true">▾</span>
            </summary>
            {s.data.steps && (
              <ol class="steps">
                {s.data.steps.split('\n').map((line) => line.trim()).filter(Boolean).map((line) => (
                  <li>{line}</li>
                ))}
              </ol>
            )}
          </details>
        ))}
      </div>
    </div>
  </section>

  <section
    class="band band-pond"
    aria-labelledby="breathe-h"
    style={`--pond-art: url('${u("/images/scenery/breathe-pond.webp")}')`}
  >
    <div class="wrap breathe-wrap" data-breathe>
      <h2 id="breathe-h">Breathe with Gritty</h2>
      <p class="note">Five slow breaths, together. Smell the flower… blow
      out the candle.</p>
      <div class="breath-circle" data-circle aria-hidden="true">
        <img src={u("/images/characters/gritty-sitting.webp")} alt=""
             width="705" height="1083" />
      </div>
      <p class="breath-cue" data-cue role="status">Ready when you are.</p>
      <button type="button" class="btn btn-primary" data-breathe-btn>
        <Icon name="calm-breathe" /><span data-breathe-label>Breathe with Gritty</span>
      </button>
    </div>
  </section>

  <section class="band">
    <div class="wrap next-up card">
      <p>Feeling calm and ready for a challenge? Gritty could use your help.</p>
      <a class="btn btn-primary" href={u('/grit-zone')}><Icon name="action-strong" /> Visit the Grit Zone</a>
    </div>
  </section>
</Base>

<script>
  /* ——— feeling picker ——— */
  const feelingBtns = [...document.querySelectorAll<HTMLButtonElement>('[data-feeling]')];
  const feelOut = document.querySelector<HTMLElement>('[data-feel-response]');
  feelingBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      feelingBtns.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      if (feelOut) feelOut.textContent = btn.dataset.response ?? '';
    });
  });

  /* ——— Breathe with Gritty ———
     The circle grows and shrinks with CSS transitions (which the global
     reduced-motion kill switch turns off — the paced text cues still work),
     while timeouts drive the pacing: in 4s, out 6s, five rounds. */
  const breathe = document.querySelector<HTMLElement>('[data-breathe]');
  if (breathe) {
    const circle = breathe.querySelector<HTMLElement>('[data-circle]')!;
    const cue = breathe.querySelector<HTMLElement>('[data-cue]')!;
    const btn = breathe.querySelector<HTMLElement>('[data-breathe-btn]')!;
    const btnLabel = btn.querySelector<HTMLElement>('[data-breathe-label]')!;
    const ROUNDS = 5;
    let timer: ReturnType<typeof setTimeout> | undefined;
    let running = false;

    const stop = (message: string) => {
      running = false;
      clearTimeout(timer);
      circle.classList.remove('in');
      btnLabel.textContent = 'Breathe with Gritty';
      cue.textContent = message;
    };

    const round = (n: number) => {
      if (n > ROUNDS) {
        stop('You did it! How does your body feel?');
        return;
      }
      cue.textContent = `Breath ${n} of ${ROUNDS} — smell the flower… breathe in…`;
      circle.classList.add('in');
      timer = setTimeout(() => {
        cue.textContent = '…now blow out the candle. Slow and soft…';
        circle.classList.remove('in');
        timer = setTimeout(() => round(n + 1), 6000);
      }, 4000);
    };

    btn.addEventListener('click', () => {
      if (running) {
        stop("That's okay — come back any time.");
        return;
      }
      running = true;
      btnLabel.textContent = 'Stop';
      round(1);
    });
  }
</script>

<style>
  .note { color: var(--gg-ink-soft); margin-top: 6px; }

  /* A small Gritty and his answer sit together, centred under the faces,
     and the bubble keeps its tail so the words read as him talking to the
     child. He uses the right-facing drawing (gritty-standing-right.webp:
     Kim's standing Gritty mirrored, with his eyes left as drawn so he
     still glances toward the bubble) to put his head, not his tail, beside
     his words. The tail dots are raised from the bubble's default line to
     meet his mouth, which sits at about 46% of the drawing's height — a
     few pixels above the shared midline, since the two are centred on
     each other — so they hold that line however long the answer runs. */
  .feel-answer {
    display: grid; grid-template-columns: auto auto;
    gap: 48px; align-items: center; justify-content: center;
    justify-self: stretch;
  }
  .stand { position: relative; display: block; width: 132px; }
  .feel-gritty { position: relative; z-index: 1; display: block; width: 100%; height: auto; }
  /* The same pool of shade Gritty stands in on the hero grounds — see
     GrittyHero.astro for the geometry — mirrored left-to-right to match
     the right-facing drawing. */
  .stand::before {
    content: ''; position: absolute; z-index: 0;
    left: -2%; right: 10%; bottom: -1%; height: 10%;
    background:
      radial-gradient(40% 48% at 42% 58%, rgba(40, 48, 54, 0.52) 0%,
        rgba(40, 48, 54, 0.36) 45%, rgba(40, 48, 54, 0) 78%),
      radial-gradient(58% 62% at 46% 52%, rgba(40, 48, 54, 0.26) 0%,
        rgba(40, 48, 54, 0.14) 52%, rgba(40, 48, 54, 0) 82%);
    mix-blend-mode: multiply;
  }
  .feel-answer :global(.bubble)::before { top: calc(50% - 13px); }
  .feel-answer :global(.bubble)::after { top: calc(50% - 17px); }
  /* Narrow phones: he steps above his words rather than squeezing them, and
     the bubble drops its tail — there's no goat beside it now. */
  @media (max-width: 560px) {
    .feel-answer { grid-template-columns: 1fr; gap: 12px; justify-items: center; }
    .stand { width: 96px; }
    .feel-answer :global(.bubble)::before,
    .feel-answer :global(.bubble)::after { display: none; }
  }

  /* — feelings — */
  .feel-wrap { display: grid; gap: 22px; }
  /* Six faces share the full width of the container, one column each;
     once a column would squeeze below the tap floor they fall to two rows
     of three. */
  .feelings { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 12px; }
  @media (max-width: 640px) {
    .feelings { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  .feeling {
    display: grid; gap: 4px; justify-items: center;
    min-width: 0; min-height: var(--gg-tap); padding: 14px 12px;
    font-family: var(--gg-display); font-weight: 500; font-size: 0.98rem;
    color: var(--gg-blue); background: var(--gg-card);
    border: 2.5px solid rgba(44, 95, 138, 0.25);
    border-radius: var(--gg-radius-small); cursor: pointer;
    transition: border-color 0.15s ease, transform 0.15s ease, background 0.15s ease;
  }
  .feeling:hover { border-color: var(--gg-blue); transform: translateY(-2px); }
  .feeling[aria-pressed='true'] {
    border-color: var(--gg-blue); background: color-mix(in srgb, var(--gg-sky) 45%, #fff);
  }

  /* — strategies — */
  .strategies {
    margin-top: 24px; display: grid; gap: 14px;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  }
  .strategy { overflow: hidden; align-self: start; }
  .strategy summary {
    list-style: none; cursor: pointer;
    display: flex; gap: 14px; align-items: center;
    min-height: var(--gg-tap); padding: 18px 22px;
    font-family: var(--gg-display); font-weight: 600; font-size: 1.08rem;
    color: var(--gg-blue);
  }
  .strategy summary::-webkit-details-marker { display: none; }
  .strategy summary:hover { background: color-mix(in srgb, var(--gg-sky) 30%, transparent); }
  .strat-name { flex: 1; }
  .strat-chevron { transition: rotate 0.2s ease; color: var(--gg-ink-soft); }
  .strategy[open] .strat-chevron { rotate: 180deg; }
  .steps {
    margin: 0 22px 20px 22px; padding-left: 26px;
    display: grid; gap: 8px;
  }

  /* — breathing — */
  /* — the still pond —
     The brief drawn out: the dandelion at the left, the candle at the right,
     ripple rings dead centre under the breathing circle. The painting is 3:1
     and the band never is, so the file carries its own sky: the paint's top
     200 rows dissolve into flat #7BB8E4 and the canvas runs on up to
     2172x1640. That is what `cover` eats first. A laptop and a tablet get
     the whole painting, flower and candle both; a wide screen loses only
     sky off the top; a phone, where nothing could hold a 3:1 picture, gets
     the quiet middle — water and rings under the circle, which is the part
     that matters while a child is counting breaths. --gg-sky stands in for
     the moment before the painting arrives. */
  .band-pond {
    background: var(--gg-sky) var(--pond-art) center bottom / cover no-repeat;
  }
  /* The band re-inks itself the way the hero grounds do. The words sit on the
     painting's palest stretch, but on a phone that stretch is the flat sky
     (#7BB8E4), where --gg-blue reaches only 3.2:1 and --gg-ink-soft 3.0:1.
     So the heading and the breath cue take --gg-blue-deep (4.6:1 there, 7.2:1
     over the pale centre) and the note takes --gg-ink (6.1:1) — AA at every
     width the band can crop to. */
  .band-pond h2, .band-pond .breath-cue { color: var(--gg-blue-deep); }
  .band-pond .note { color: var(--gg-ink); }

  .breathe-wrap { display: grid; gap: 18px; justify-items: center; text-align: center; }
  .breath-circle {
    width: 150px; height: 150px; margin-block: 20px; border-radius: 50%;
    display: grid; place-items: center; font-size: 3rem;
    background: radial-gradient(circle at 35% 30%, #fff, var(--gg-sky));
    border: 3px solid var(--gg-blue);
    box-shadow: var(--gg-shadow);
    transform: scale(1);
    transition: transform 6s ease-in-out;
  }
  .breath-circle img { width: auto; height: 108px; }
  .breath-circle.in { transform: scale(1.45); transition-duration: 4s; }
  .breath-cue {
    font-family: var(--gg-hand); font-size: 1.5rem; color: var(--gg-blue);
    min-height: 2.2em;
  }

  .next-up {
    display: flex; flex-wrap: wrap; align-items: center; gap: 16px 32px;
    padding: 28px 36px;
  }
  .next-up p { flex: 1; min-width: 240px; }
  .next-up .btn { flex: none; }
</style>
