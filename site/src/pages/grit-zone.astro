---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Bubble from '../components/Bubble.astro';
import Icon from '../components/Icon.astro';
import { u } from '../lib/url';
import fs from 'node:fs';
import path from 'node:path';

const scenarios = (await getCollection('scenarios')).sort((a, b) => a.data.order - b.data.order);
const yets = (await getCollection('yet-sentences')).sort((a, b) => a.data.order - b.data.order);

/* The private "How did YOU have grit today?" checklist. Fixed list, not CMS:
   it mirrors the "what is grit" vocabulary used across the site. The label
   strings are also the localStorage keys — changing one orphans saved days. */
const checkin: { icon: string; label: string }[] = [
  { icon: 'action-try-again', label: 'Kept trying' },
  { icon: 'action-something-new', label: 'Tried something new' },
  { icon: 'action-idea', label: 'Learned from a mistake' },
  { icon: 'action-ask-for-help', label: 'Asked for help' },
  { icon: 'heart-hands-helped', label: 'Helped someone' },
  { icon: 'action-calm-break', label: 'Took a calming break' },
  { icon: 'heart-kind', label: 'Was kind' },
  { icon: 'badge-star', label: 'Believed in myself' },
];

/* ——— The Grit Trail: board-game geometry ———
   The scenarios stop being a stack of cards and become stops on a path up
   the mountain (the same mountain the streak line and ⛰️ icon already use).
   One challenge on screen at a time; the map is the progress display, so
   there is no "3 of 15" counter anywhere (V3-CRAFT: the map shows the
   journey, numbers read as a contract).

   A climb is TRAIL_LEN stops — six, two switchbacks of three: long
   enough to feel like a mountain, short enough that a five-year-old sees
   the summit in one sitting. Kim can write as many scenarios as she likes:
   each climb takes the next TRAIL_LEN of them in order, wrapping round, so
   "Start a new climb" brings new challenges and nothing she wrote is ever
   left off the trail (the rotation lives in the script below). */
const TRAIL_LEN = 6;
const PER_ROW = 3;
const N = Math.min(scenarios.length, TRAIL_LEN);
const rows = Math.ceil(N / PER_ROW);
const W = 800;
const X_MIN = 170;
const X_MAX = 630;
/* The backdrop is one pixel-art drawing (public/images/grit-zone/trail-bg.webp,
   the 1024×1536 original cropped top-anchored to 1024×1290 so the stops sit
   on mountain). It sets how much sky sits above the top switchback, and its
   snow cap is where the flag goes — peakX/peakY were measured off the
   drawing's topmost snow pixel. A 16th scenario grows the scene taller than
   the drawing; the drawing then scales to height and loses a sliver off
   each side. */
const BG = { w: 1024, h: 1290, peakX: 0.568, peakY: 0.128 };
const SCENE_H = Math.round((W * BG.h) / BG.w);
const BOTTOM_AIR = 120;  /* room below for the trailhead */
const TOP_ROW_Y = 440;   /* the top switchback, just under the rock */
/* the switchbacks spread to fill the mountain between the two, but never
   closer than 150 (the turns would crowd) or farther than 230 (the turns
   would run off the sides); more rows than fit make the scene taller */
const ROW_GAP = rows > 1
  ? Math.min(230, Math.max(150, Math.round((SCENE_H - BOTTOM_AIR - TOP_ROW_Y) / (rows - 1))))
  : 150;
const TURN_R = ROW_GAP / 2;
const H = Math.max(SCENE_H, TOP_ROW_Y + (rows - 1) * ROW_GAP + BOTTOM_AIR);
const rowY = (r: number) => H - BOTTOM_AIR - r * ROW_GAP;
const slotX = (k: number) => X_MIN + (k * (X_MAX - X_MIN)) / (PER_ROW - 1);

const stops = scenarios.slice(0, N).map((s, i) => {
  const r = Math.floor(i / PER_ROW);
  const k = i % PER_ROW;
  const x = r % 2 === 0 ? slotX(k) : slotX(PER_ROW - 1 - k);
  return { id: s.id, x, y: rowY(r) };
});

/* the flag on the peak: wherever the drawing's snow cap lands once it is
   scaled to cover the scene (xMidYMin slice, mirrored in the markup) */
const bgScale = Math.max(W / BG.w, H / BG.h);
const SX = Math.round((W - BG.w * bgScale) / 2 + BG.peakX * BG.w * bgScale);
const SY = Math.round(BG.peakY * BG.h * bgScale);
/* the flag sprite: its pole stands 25% in from the left, and the grass
   tuft at its foot ends 96% down — that tuft sits on the snow */
const FLAG = 120;
const flagX = Math.round(SX - 0.25 * FLAG);
const flagY = Math.round(SY + 10 - 0.96 * FLAG);

/* The path: a switchback trail — straight rows joined by half-circle turns,
   then a final climb curve to the flag. Drawn once, walked many times. */
let trailD = `M 64 ${H - 26} Q 90 ${rowY(0) + 26} ${X_MIN - 6} ${rowY(0)}`;
for (let r = 0; r < rows; r++) {
  const yr = rowY(r);
  const goingRight = r % 2 === 0;
  if (r < rows - 1) {
    const turnX = goingRight ? X_MAX + 12 : X_MIN - 12;
    trailD += ` L ${turnX} ${yr}`
      + ` A ${TURN_R} ${TURN_R} 0 0 ${goingRight ? 0 : 1} ${turnX} ${yr - ROW_GAP}`;
  } else {
    const end = stops[N - 1];
    trailD += ` L ${end.x} ${yr}`;
    trailD += goingRight
      ? ` C ${end.x + 110} ${yr - 30} ${SX + 150} ${SY + 60} ${SX} ${SY + 6}`
      : ` C ${end.x - 110} ${yr - 30} ${SX - 150} ${SY + 60} ${SX} ${SY + 6}`;
  }
}

/* percent coordinates so HTML stop buttons overlay the SVG at any width */
const pct = (x: number, y: number) => ({
  x: ((x / W) * 100).toFixed(2),
  y: ((y / H) * 100).toFixed(2),
});
const stopPts = stops.map((s, i) => ({ id: s.id, row: Math.floor(i / PER_ROW), ...pct(s.x, s.y) }));
const summitPt = pct(SX, SY);

/* ——— Art that hasn't landed yet ———
   The cabinet has slots for drawings that don't exist yet (the prompts are
   in ARCADE-PROMPTS.md). Each slot checks for its file at build time and
   takes a stand-in until it lands: drop the file into
   public/images/grit-zone/ under the name below and the slot fills on the
   next build, no code change. */
const landed = (file: string) =>
  fs.existsSync(path.resolve(process.cwd(), 'public/images/grit-zone', file));
const art = (file: string) => (landed(file) ? u(`/images/grit-zone/${file}`) : null);
/* Gritty's portrait in the dialog box.

   The four drawn expressions (face-think / idea / oops / cheer) did not
   hold up beside the walker tile — the raised hoof and the props read as
   smudges at 64 pixels — so the tile does every beat, as it does on the
   map. The files are still in public/images/grit-zone/ and the swap
   below is one flag away: set FACE_SWAP to true to bring them back. */
const FACE_SWAP = false;
const tile = u('/images/grit-zone/walker.webp');
const faces = FACE_SWAP
  ? {
      think: art('face-think.webp') ?? tile,
      idea: art('face-idea.webp') ?? tile,
      oops: art('face-oops.webp') ?? tile,
      cheer: art('face-cheer.webp') ?? tile,
    }
  : { think: tile, idea: tile, oops: tile, cheer: tile };
const stageBg = art('stage-bg.webp');   /* sky and meadow behind the dialog boxes */
const cursor = art('cursor.webp');      /* the menu cursor beside a choice */
const summit = art('summit.webp');      /* Gritty on the peak, for the finale */
const logo = art('logo.webp');          /* the game's title, on the cabinet's marquee */
const tabArt = {                        /* pixel sprites for the three game tabs */
  trail: art('tab-trail.webp'),
  yet: art('tab-yet.webp'),
  day: art('tab-day.webp'),
};
---

<Base
  title="The Grit Zone — Growing with Gritty"
  description="Climb the Grit Trail with Gritty the Goat, feel the Power of YET, and tell Gritty how you showed grit today — right on your own device."
>
  <section class="band hero-blue">
    <div class="wrap intro">
      <div class="intro-copy">
        <p class="eyebrow">Gritty's World</p>
        <h1>The Grit Zone <Icon name="action-strong" size="1.1em" /></h1>
        <Bubble tail={false}>
          "Welcome to the Grit Zone! Pick a game — let's practice grit
          together."
        </Bubble>
      </div>

      {/* The trailhead drawing. The arrow sign in the scene is blank on
          purpose — the site prints the words on it, same as the Erin School
          sign in the hero, so a rename never needs new art. */}
      <div class="trailhead">
        <img src={u("/images/grit-zone/trailhead.webp")}
             alt="Gritty the Goat, backpack on, standing at a trail sign where a winding path climbs to a flag on the mountaintop."
             width="1400" height="933" />
        <span class="trailhead-sign" aria-hidden="true">Grit Trail</span>
      </div>
    </div>
  </section>

  <section class="band band-sky arcade" aria-labelledby="zone-h">
    <div class="wrap">
      <h2 id="zone-h" class="visually-hidden">Pick a game</h2>

      <noscript>
        <p class="note"><strong>Psst:</strong> the ⭐ shows the grit choice!</p>
        <style is:inline>
          /* Without JS the games unfold as honest sections: tabs and the
             trail map (both JS machines) step aside, every scenario shows
             with its star marked, and the panels all appear. */
          .gz-tabs { display: none; }
          .gz-panel[hidden] { display: block; }
          [data-quiz] .scenario { display: grid !important; }
          .scenario[data-answer='a'] .choice[data-key='a']::after,
          .scenario[data-answer='b'] .choice[data-key='b']::after,
          .scenario[data-answer='c'] .choice[data-key='c']::after { content: ' ⭐'; }
          .scenario [data-cheer][hidden] { display: grid; }
          .scenario [data-ask] { display: none; }
          .scenario [data-ask-said][hidden] { display: block; }
          .scenario [data-flee] { display: none; }
        </style>
      </noscript>

      <div class="gz-tabs" role="tablist" aria-label="Pick a game">
        <button class="gz-tab" role="tab" id="tab-trail" aria-controls="panel-trail"
                aria-selected="true" data-tab>
          <span class="ico" aria-hidden="true">{tabArt.trail
            ? <img src={tabArt.trail} alt="" width="48" height="48" />
            : <Icon name="action-mountain-streak" size="2.9rem" />}</span>
          <span>The Grit Trail</span>
        </button>
        <button class="gz-tab" role="tab" id="tab-yet" aria-controls="panel-yet"
                aria-selected="false" tabindex="-1" data-tab>
          <span class="ico" aria-hidden="true">{tabArt.yet
            ? <img src={tabArt.yet} alt="" width="48" height="48" />
            : <Icon name="action-something-new" size="2.9rem" />}</span>
          <span>Power of YET</span>
        </button>
        <button class="gz-tab" role="tab" id="tab-day" aria-controls="panel-day"
                aria-selected="false" tabindex="-1" data-tab>
          <span class="ico" aria-hidden="true">{tabArt.day
            ? <img src={tabArt.day} alt="" width="48" height="48" />
            : <Icon name="heart-kind" size="2.3rem" />}</span>
          <span>My Grit Day</span>
        </button>
      </div>

      {/* ————— Game 1: the Grit Trail ————— */}
      <section class="gz-panel" id="panel-trail" role="tabpanel"
               aria-labelledby="tab-trail" tabindex="0">
        <div class="panel-head">
          <h2>Can you help Gritty?</h2>
          <p class="note">Tap the glowing stop and climb the trail with
          Gritty — one challenge at a time. No points and no timers, just
          you and a goat figuring it out.</p>
        </div>

        {/* The cabinet: the map is the game's screen, and the button that
            starts a challenge sits on the machine, under the screen, where
            a start button goes. The challenge and the summit wear the same
            shell, so tapping Play never feels like leaving the game. */}
        <div class="trail cab" data-trail data-sx={summitPt.x} data-sy={summitPt.y} hidden>
          {/* the marquee: an arcade machine names its game above the
              screen. Empty until logo.webp lands; the HUD carries the
              words until then. */}
          {logo && <div class="cab-marquee"><img src={logo} alt="The Grit Trail" width="480" height="160" /></div>}
          <div class="cab-hud">
            {!logo && <span class="hud-title"><Icon name="action-mountain-streak" size="1.35em" /> The Grit Trail</span>}
            <span class="tile hud-tile" data-hud-stop aria-hidden="true"></span>
          </div>
          <div class="trail-scene cab-screen"
               style={`aspect-ratio: ${W} / ${H};`
                 + ['ahead', 'current', 'done']
                   .map((st) => ` --stop-${st}: url('${u(`/images/grit-zone/stop-${st}.webp`)}');`)
                   .join('')}>
            <svg class="trail-art" viewBox={`0 0 ${W} ${H}`} aria-hidden="true"
                 preserveAspectRatio="xMidYMid meet">
              <defs>
                <clipPath id="gz-frame"><rect x="0" y="0" width={W} height={H} rx="10" /></clipPath>
              </defs>
              {/* the whole landscape is one drawing; only the trail is code,
                  so the stops always sit on it */}
              <image class="backdrop" style="image-rendering: pixelated;" href={u('/images/grit-zone/trail-bg.webp')}
                     x="0" y="0" width={W} height={H}
                     preserveAspectRatio="xMidYMin slice" clip-path="url(#gz-frame)" />
              {/* the trail: an inked edge, a sandy tread, and a run of
                  gold stepping-stones — an overworld path, drawn as tiles */}
              <path class="trail-under" d={trailD} />
              <path class="trail-mid" d={trailD} />
              <path class="trail-stitch" d={trailD} />
              {/* the summit flag */}
              <image class="flag" style="image-rendering: pixelated;" href={u('/images/grit-zone/flag.webp')}
                     x={flagX} y={flagY} width={FLAG} height={FLAG} />
            </svg>

            {/* The stops are real buttons overlaying the drawing, so little
                fingers get true 48px targets and screen readers get words. */}
            {stopPts.map((s, i) => (
              <button type="button" class="stop" data-stop data-id={s.id}
                      data-x={s.x} data-y={s.y}
                      style={`left: ${s.x}%; top: ${s.y}%; --row: ${s.row};`} disabled>
                <span class="stop-num" aria-hidden="true">{i + 1}</span>
              </button>
            ))}

            {/* Gritty walks the map — progress you can watch, not count */}
            <div class="walker" data-walker aria-hidden="true">
              <img src={u('/images/grit-zone/walker.webp')} alt=""
                   width="64" height="64" />
            </div>
          </div>

          <div class="cab-bar">
            <button type="button" class="btn btn-gold cab-btn trail-play" data-play>
              <Icon name="ui-play" /> Play the glowing challenge
            </button>
          </div>
        </div>

        <div class="quiz" data-quiz>
          {scenarios.map((s, i) => (
            <article class="scenario cab" data-scenario data-id={s.id} data-answer={s.data.answer}>
              {logo && <div class="cab-marquee small"><img src={logo} alt="The Grit Trail" width="480" height="160" /></div>}
              <div class="cab-hud">
                <button type="button" class="flee" data-flee><Icon name="ui-back" /> Back to the trail</button>
                <span class="tile hud-tile" aria-hidden="true">Stop {i + 1}</span>
              </div>
              <div class:list={['cab-screen', 'stage', { 'has-bg': !!stageBg }]}
                   style={stageBg ? `--stage-bg: url('${stageBg}');` : undefined}>
              {/* the dialog box: Gritty's portrait tile (the same tile that
                  walks the map) and what he's up against */}
              <div class="say">
                <img class="face" data-face src={faces.think} alt="" width="64" height="64"
                     data-face-think={faces.think} data-face-idea={faces.idea}
                     data-face-oops={faces.oops} data-face-cheer={faces.cheer} />
                <h3 class="situation">{s.data.situation}</h3>
              </div>
              <div class:list={['choices', { 'has-cursor': !!cursor }]} role="group"
                   aria-label="What should Gritty do?"
                   style={cursor ? `--cursor: url('${cursor}');` : undefined}>
                {([['a', s.data.choiceA], ['b', s.data.choiceB], ['c', s.data.choiceC]] as const).map(([key, text]) => (
                  <button type="button" class="choice" data-key={key}>
                    <b aria-hidden="true">{key.toUpperCase()}</b>
                    <span>{text}</span>
                  </button>
                ))}
              </div>
              {s.data.hint && (
                <div class="ask">
                  <button type="button" class="ask-btn" data-ask>
                    <img src={u('/images/grit-zone/walker.webp')} alt=""
                         width="34" height="34" loading="lazy" />
                    Ask Gritty for an idea
                  </button>
                  <p class="ask-said" data-ask-said hidden>
                    "{s.data.hint}"
                  </p>
                </div>
              )}
              {/* Shown-and-hidden things carry no live role: a region that
                  appears with its words already in it goes unannounced.
                  The script speaks them through the page's announcer. */}
              <p class="nudge" data-nudge hidden>
                Hmm — would that help Gritty keep going? Try another one!
              </p>
              {/* the payoff: the same gold coin the map keeps, so the reward
                  on this screen is visibly the star that lands on the trail */}
              <div class="cheer" data-cheer hidden>
                <img class="cheer-coin" src={u('/images/grit-zone/stop-done.webp')} alt=""
                     width="72" height="72" loading="lazy" />
                <p class="cheer-title">Gritty's Grit Choice!</p>
                <p class="cheer-motto">"I have grit! I don't quit!"</p>
                {s.data.cheer && <p class="cheer-why">{s.data.cheer}</p>}
                <p class="cheer-what">Grit means we keep trying, learn from
                mistakes, and use strategies when something is difficult.</p>
              </div>
              </div>
              <div class="cab-bar">
                <button type="button" class="btn btn-gold cab-btn" data-back hidden>
                  Back to the trail <Icon name="action-mountain-streak" />
                </button>
              </div>
            </article>
          ))}
        </div>

        <div class="finale cab" data-finale tabindex="-1" hidden>
          {logo && <div class="cab-marquee small"><img src={logo} alt="The Grit Trail" width="480" height="160" /></div>}
          <div class="cab-hud">
            <span class="hud-title"><Icon name="badge-star-burst" size="1.35em" /> The summit</span>
          </div>
          {/* The view from the top. Once summit.webp lands it fills the
              screen edge to edge — Gritty on the peak, the whole meadow far
              below — and the words sit under it. Until then, the flag. */}
          <div class:list={['cab-screen', 'stage', 'finale-screen',
                            { 'has-bg': !!stageBg && !summit, 'has-summit': !!summit }]}
               style={stageBg && !summit ? `--stage-bg: url('${stageBg}');` : undefined}>
            {/* lazy: the summit only appears after six challenges, and
                `hidden` does not stop a fetch — without this every visit
                pays for a screen most of them never reach */}
            {summit
              ? <img class="finale-art" src={summit} loading="lazy"
                     alt="Gritty stands on the mountaintop beside the flag, looking out over the whole meadow far below."
                     width="1536" height="1024" />
              : <img class="finale-flag" src={u('/images/grit-zone/flag.webp')} alt="" width="110" height="110" />}
            <div class="say finale-say">
              <h3>You climbed the whole trail!</h3>
              <p>You helped Gritty {N} times. You know what grit
              looks like: trying again, taking a breath, asking for help, and
              never giving up.</p>
              <p class="finale-motto">"I have grit! I don't quit!"</p>
            </div>
          </div>
          <div class="cab-bar">
            <button type="button" class="btn btn-gold cab-btn" data-replay><Icon name="action-try-again" /> Start a new climb</button>
          </div>
        </div>
      </section>

      {/* ————— Game 2: the YET Machine ————— */}
      <section class="gz-panel" id="panel-yet" role="tabpanel"
               aria-labelledby="tab-yet" tabindex="0" hidden>
        <div class="panel-head">
          <h2>The Power of YET</h2>
          <p class="note">One little word turns "I can't" into "not yet."
          Press the big gold button and watch it work.</p>
        </div>

        <ul class="yet-list" data-yet-static role="list">
          {yets.map((y) => (
            <li data-sentence={y.data.sentence} data-tip={y.data.tip ?? ''}>
              {y.data.sentence} <b class="yet-gold">YET!</b>
              {y.data.tip && <span class="yet-tip-static">Gritty says: "{y.data.tip}"</span>}
            </li>
          ))}
        </ul>

        <div class="yet-machine cab" data-yet hidden>
          <div class="cab-hud">
            <span class="hud-title"><Icon name="action-something-new" size="1.35em" /> The YET machine</span>
          </div>
          <div class="yet-screen cab-screen">
            <p class="yet-line">
              <span data-yet-sentence></span>
              <b class="yet-gold yet-word" data-yet-word hidden>YET!</b>
            </p>
            <p class="yet-cheer" data-yet-cheer hidden>
              YET is a magic word — it means your brain is still growing!
              <Icon name="action-brain-grows" />
            </p>
          </div>
          <p class="yet-tip" data-yet-tip hidden></p>
          <div class="cab-bar yet-buttons">
            <button type="button" class="yet-press" data-yet-press>YET!</button>
            <button type="button" class="btn btn-ghost" data-yet-next hidden>Another one <Icon name="ui-next-arrow" /></button>
          </div>
        </div>
      </section>

      {/* ————— Game 3: My Grit Day ————— */}
      <section class="gz-panel" id="panel-day" role="tabpanel"
               aria-labelledby="tab-day" tabindex="0" hidden>
        <div class="panel-head">
          <h2>How did YOU have grit today?</h2>
          <p class="note">Tap every badge you earned today — Gritty wants to
          hear it!</p>
        </div>
        <ul class="checkin" role="list" data-checkin>
          {checkin.map(({ icon, label }) => (
            <li>
              <label class="check-chip">
                <input type="checkbox" data-check={label}
                       aria-label={`Today I ${label.toLowerCase()}`} />
                <span class="coin">
                  <span class="chip-emoji" aria-hidden="true">
                    <Icon name={icon} size="3.4rem" />
                  </span>
                </span>
                <span class="coin-label" aria-hidden="true">{label}</span>
              </label>
            </li>
          ))}
        </ul>
        <p class="checkin-cheer" data-checkin-cheer hidden>
          <Icon name="action-celebrate" /> WOW! You showed grit today!
        </p>
        <p class="streak" hidden data-streak-line><Icon
          name="action-mountain-streak" /> <span data-streak></span></p>
        <p class="privacy">This stays right here on your device — only you can
        see it. Nothing is ever sent anywhere.</p>
      </section>
    </div>
  </section>

  {/* the door to the Mistake Maker, wearing that room's lime so it reads
      as its own strip rather than more of the paper above it */}
  <section class="band band-lime">
    <div class="wrap next-up card">
      <p>Made a mistake today? Lucky you — mistakes are how brains grow.</p>
      <a class="btn btn-primary" href={u('/mistake-maker')}><Icon name="action-brain-grows" /> Visit the Mistake Maker</a>
    </div>
  </section>
</Base>

<!-- Sparks are created by JS, so their keyframes must be global — scoped
     keyframes can't reach JS-made elements. Same pattern as the hero. -->
<style is:global>
  @keyframes gz-spark {
    0% { translate: 0 0; scale: 0; opacity: 1; }
    20% { scale: 1; }
    100% { translate: var(--dx) var(--dy); scale: 0.4; opacity: 0; }
  }
</style>

<script>
  /* ————————————————————————————————————————————————
     The Grit Zone plays by the house research rules (V3-CRAFT):
     hit-stop before every payoff, springs not fades, something permanent
     left behind after each celebration, praise that stays specific and
     understated, and reduced motion as replacement — the star still
     appears, it just doesn't fly.
     ———————————————————————————————————————————————— */
  import { announce } from '../lib/announce';

  const calm = matchMedia('(prefers-reduced-motion: reduce)');
  /* the OS setting, or the site's own "Pause animations" switch */
  const isCalm = () => calm.matches || document.documentElement.dataset.motion === 'calm';
  /* what a shown element says, as one line for the announcer */
  const words = (el: Element) => (el.textContent ?? '').replace(/\s+/g, ' ').trim();

  /* gold sparks — celebration only, and never under reduced motion */
  function burst(el: Element, count = 12) {
    if (isCalm()) return;
    const r = el.getBoundingClientRect();
    const box = document.createElement('div');
    box.setAttribute('aria-hidden', 'true');
    box.style.cssText =
      `position:fixed;left:${r.left + r.width / 2}px;top:${r.top + r.height / 2}px;` +
      'z-index:150;pointer-events:none;';
    /* The tokens themselves, not their values re-typed as hex. These
       land in an inline `background:`, and the sparks are appended to
       <body>, so each var() resolves against :root the same way every
       other colour on the site does — retune a token and the
       celebration follows it instead of quietly drifting off-brand. */
    const hues = ['var(--gg-gold)', 'var(--gg-green)', 'var(--gg-blue)',
                  'var(--gg-sky)', 'var(--gg-sun)'];
    for (let i = 0; i < count; i++) {
      const s = document.createElement('i');
      const ang = (Math.PI * 2 * i) / count;
      const dist = 58 + (i % 3) * 24;
      s.style.cssText =
        'position:absolute;width:9px;height:9px;border-radius:50%;' +
        `background:${hues[i % hues.length]};` +
        `--dx:${Math.cos(ang) * dist}px;--dy:${Math.sin(ang) * dist - 30}px;` +
        `animation:gz-spark 800ms ease-out ${i * 12}ms forwards;`;
      box.appendChild(s);
    }
    document.body.appendChild(box);
    setTimeout(() => box.remove(), 1250);
  }

  const replay = (el: Element, cls: string) => {
    el.classList.remove(cls);
    void (el as HTMLElement).offsetWidth;
    el.classList.add(cls);
  };

  /* ——— the arcade tabs: three games, one on stage at a time ——— */
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-tab]')];
  const panels = tabs.map((t) => document.getElementById(t.getAttribute('aria-controls')!)!);
  function selectTab(n: number, focus = false) {
    tabs.forEach((t, j) => {
      t.setAttribute('aria-selected', String(j === n));
      t.tabIndex = j === n ? 0 : -1;
      panels[j].hidden = j !== n;
    });
    replay(panels[n], 'enter');
    if (focus) tabs[n].focus();
  }
  tabs.forEach((t, n) => {
    t.addEventListener('click', () => selectTab(n));
    t.addEventListener('keydown', (e) => {
      const move = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
      if (move) selectTab((n + move + tabs.length) % tabs.length, true);
      else if (e.key === 'Home') selectTab(0, true);
      else if (e.key === 'End') selectTab(tabs.length - 1, true);
      else return;
      e.preventDefault();
    });
  });

  /* ——— Game 1: the Grit Trail ——— */
  const trail = document.querySelector<HTMLElement>('[data-trail]');
  const quiz = document.querySelector<HTMLElement>('[data-quiz]');
  if (trail && quiz) {
    const cards = [...quiz.querySelectorAll<HTMLElement>('[data-scenario]')];
    const stops = [...trail.querySelectorAll<HTMLButtonElement>('[data-stop]')];
    const walker = trail.querySelector<HTMLElement>('[data-walker]')!;
    const playBtn = trail.querySelector<HTMLElement>('[data-play]')!;
    const hudStop = trail.querySelector<HTMLElement>('[data-hud-stop]')!;
    const finale = document.querySelector<HTMLElement>('[data-finale]')!;

    /* progress lives on this device only, like the check-in */
    const KEY = 'gg-grit-trail';
    const load = (): { done: string[]; climb: number } => {
      try {
        const s = JSON.parse(localStorage.getItem(KEY) ?? 'null');
        return {
          done: Array.isArray(s?.done) ? s.done : [],
          climb: Number.isInteger(s?.climb) ? s.climb : 0,
        };
      } catch { return { done: [], climb: 0 }; }
    };
    const saved = load();
    let climb = saved.climb;
    const done = new Set<string>(saved.done);
    const save = () => {
      try { localStorage.setItem(KEY, JSON.stringify({ done: [...done], climb })); }
      catch { /* private window — the climb still works, it just won't keep */ }
    };

    /* Which challenges are on the mountain this climb: the stops are fixed
       (the trail is drawn at build time), the scenarios rotate through them.
       Climb 0 is the first six Kim wrote, climb 1 the next six, wrapping
       round — so every scenario gets its turn on the trail. */
    const cardIds = cards.map((c) => c.dataset.id!);
    const cardAt = (stop: number) => (climb * stops.length + stop) % cards.length;
    const ids = () => stops.map((_, i) => cardIds[cardAt(i)]);

    const currentIdx = () => ids().findIndex((id) => !done.has(id));

    /* the map is the scoreboard: stars stay (permanence), the next stop
       glows (the idle hint), the rest is just trail ahead */
    function render(justId?: string) {
      const cur = currentIdx();
      const onTrail = ids();
      stops.forEach((el, i) => {
        el.dataset.id = onTrail[i];
        const isDone = done.has(el.dataset.id!);
        el.classList.toggle('done', isDone);
        el.classList.toggle('current', i === cur);
        el.disabled = !isDone && i !== cur;
        el.setAttribute('aria-label',
          isDone ? `Challenge ${i + 1} — you earned this star! Play it again`
          : i === cur ? `Challenge ${i + 1} — Gritty is waiting. Tap to play!`
          : `Challenge ${i + 1} — farther up the trail`);
        if (el.dataset.id === justId) { replay(el, 'just'); burst(el); }
      });
      const at = cur === -1
        ? { x: trail.dataset.sx!, y: trail.dataset.sy! }
        : { x: stops[cur].dataset.x!, y: stops[cur].dataset.y! };
      walker.style.left = `${at.x}%`;
      walker.style.top = `${at.y}%`;
      if (justId) replay(walker, 'hop');
      finale.hidden = cur !== -1;
      playBtn.hidden = cur === -1;
      /* the HUD names the glowing stop, and the challenge's HUD answers it */
      hudStop.hidden = cur === -1;
      hudStop.textContent = cur === -1 ? '' : `Stop ${cur + 1}`;
    }

    const showTrail = () => {
      cards.forEach((c) => { c.hidden = true; });
      trail.hidden = false;
    };
    /* open the challenge standing at stop i */
    function openChallenge(i: number) {
      const at = cardAt(i);
      trail.hidden = true;
      finale.hidden = true;
      cards.forEach((c, j) => { c.hidden = j !== at; });
      /* the card's HUD names the stop it stands at this climb, matching
         the map's tile, not its place in Kim's list */
      const tile = cards[at].querySelector<HTMLElement>('.hud-tile');
      if (tile) tile.textContent = `Stop ${i + 1}`;
      cards[at].querySelector<HTMLElement>('.situation')?.focus();
    }

    cards.forEach((card, i) => {
      const situation = card.querySelector<HTMLElement>('.situation')!;
      situation.setAttribute('tabindex', '-1');
      const nudge = card.querySelector<HTMLElement>('[data-nudge]')!;
      const cheer = card.querySelector<HTMLElement>('[data-cheer]')!;
      const back = card.querySelector<HTMLElement>('[data-back]')!;
      const flee = card.querySelector<HTMLElement>('[data-flee]')!;
      const ask = card.querySelector<HTMLButtonElement>('[data-ask]');
      const askSaid = card.querySelector<HTMLElement>('[data-ask-said]');
      /* Gritty's portrait changes with the beat: thinking, an idea, an
         oops, a cheer. All four are one drawing until the faces land. */
      const face = card.querySelector<HTMLImageElement>('[data-face]');
      const setFace = (k: 'think' | 'idea' | 'oops' | 'cheer') => {
        const src = face?.getAttribute(`data-face-${k}`);
        if (face && src && face.getAttribute('src') !== src) face.setAttribute('src', src);
      };

      ask?.addEventListener('click', () => {
        askSaid!.hidden = false;
        ask.hidden = true;
        setFace('idea');
        announce(`Gritty says: ${words(askSaid!)}`);
      });

      card.querySelectorAll<HTMLButtonElement>('.choice').forEach((btn) => {
        btn.addEventListener('click', () => {
          if (card.classList.contains('solved')) return;
          if (btn.dataset.key === card.dataset.answer) {
            /* hit stop: a beat between the press and the payoff makes the
               star feel earned rather than automatic */
            card.classList.add('solved');
            setTimeout(() => {
              btn.classList.add('is-grit');
              setFace('cheer');
              nudge.hidden = true;
              cheer.hidden = false;
              back.hidden = false;
              burst(btn.querySelector('b')!);
              announce(words(cheer));
            }, 100);
          } else {
            btn.classList.add('tried');
            replay(btn, 'shake');
            setFace('oops');
            nudge.hidden = false;
            announce(words(nudge));
            /* Sesame's scaffold: after a miss, the hint offers itself */
            if (ask && !ask.hidden) ask.classList.add('beckon');
          }
        });
      });

      const finish = () => {
        const id = cardIds[i];
        const fresh = !done.has(id);
        if (fresh) { done.add(id); save(); }
        /* reset the card so a replay starts clean */
        card.classList.remove('solved');
        card.querySelectorAll('.choice').forEach((b) => b.classList.remove('tried', 'is-grit', 'shake'));
        nudge.hidden = true;
        cheer.hidden = true;
        back.hidden = true;
        if (ask) { ask.hidden = false; ask.classList.remove('beckon'); askSaid!.hidden = true; }
        setFace('think');
        showTrail();
        /* let the map paint at the old state, then move — so the star pops
           and Gritty visibly hops to the next stop. A timer, not rAF: rAF
           never fires in a hidden tab, and the state must land regardless. */
        setTimeout(() => {
          render(fresh ? id : undefined);
          const cur = currentIdx();
          (cur === -1 ? finale : stops[cur]).focus();
        }, 60);
      };
      back.addEventListener('click', finish);
      flee.addEventListener('click', () => { showTrail(); render(); playBtn.focus(); });
    });

    stops.forEach((el, i) => el.addEventListener('click', () => openChallenge(i)));
    playBtn.addEventListener('click', () => {
      const cur = currentIdx();
      if (cur !== -1) openChallenge(cur);
    });

    /* a new climb: the stars come off the map and the next set of
       challenges rotates onto it */
    finale.querySelector('[data-replay]')?.addEventListener('click', () => {
      done.clear();
      climb += 1;
      save();
      render();
      const first = stops[0];
      first.focus();
      burst(first, 8);
    });

    quiz.classList.add('armed');
    showTrail();
    render();
  }

  /* ——— Game 2: the YET Machine ——— */
  const yetMachine = document.querySelector<HTMLElement>('[data-yet]');
  const yetStatic = document.querySelector<HTMLElement>('[data-yet-static]');
  if (yetMachine && yetStatic) {
    const sentences = [...yetStatic.querySelectorAll<HTMLElement>('li')]
      .map((li) => ({ text: li.dataset.sentence ?? '', tip: li.dataset.tip ?? '' }));
    if (sentences.length > 0) {
      yetStatic.hidden = true;
      yetMachine.hidden = false;

      const sentenceEl = yetMachine.querySelector<HTMLElement>('[data-yet-sentence]')!;
      const wordEl = yetMachine.querySelector<HTMLElement>('[data-yet-word]')!;
      const cheerEl = yetMachine.querySelector<HTMLElement>('[data-yet-cheer]')!;
      const tipEl = yetMachine.querySelector<HTMLElement>('[data-yet-tip]')!;
      const pressBtn = yetMachine.querySelector<HTMLElement>('[data-yet-press]')!;
      const nextBtn = yetMachine.querySelector<HTMLElement>('[data-yet-next]')!;
      let i = 0;

      const load = (n: number) => {
        sentenceEl.textContent = sentences[n].text;
        wordEl.hidden = true;
        cheerEl.hidden = true;
        tipEl.hidden = true;
        nextBtn.hidden = true;
        pressBtn.hidden = false;
      };

      pressBtn.addEventListener('click', () => {
        replay(yetMachine, 'rumble');
        /* hit stop, then the word slams in */
        setTimeout(() => {
          wordEl.hidden = false;
          replay(wordEl, 'pop');
          burst(wordEl, 10);
          cheerEl.hidden = false;
          const tip = sentences[i].tip;
          tipEl.hidden = !tip;
          if (tip) tipEl.textContent = `Gritty says: "${tip}"`;
          pressBtn.hidden = true;
          nextBtn.hidden = false;
          announce(`${sentences[i].text} YET! ${words(cheerEl)}${tip ? ` Gritty says: ${tip}` : ''}`);
          nextBtn.focus();
        }, 110);
      });

      nextBtn.addEventListener('click', () => {
        i = (i + 1) % sentences.length;
        load(i);
        (pressBtn as HTMLButtonElement).focus();
      });

      load(0);
    }
  }

  /* ——— Game 3: My Grit Day — saved to this device only ——— */
  const checkinList = document.querySelector<HTMLElement>('[data-checkin]');
  if (checkinList) {
    const boxes = [...checkinList.querySelectorAll<HTMLInputElement>('input')];
    const cheer = document.querySelector<HTMLElement>('[data-checkin-cheer]')!;
    const streakEl = document.querySelector<HTMLElement>('[data-streak]')!;
    const streakLine = document.querySelector<HTMLElement>('[data-streak-line]')!;
    const KEY = 'gg-grit-checkin';
    const today = new Date().toLocaleDateString('en-CA'); /* YYYY-MM-DD, local */

    /* localStorage can throw (private windows, blocked storage) — the
       badges must keep working without it. */
    const read = (): any => {
      try { return JSON.parse(localStorage.getItem(KEY) ?? 'null'); } catch { return null; }
    };
    const write = (s: unknown) => {
      try { localStorage.setItem(KEY, JSON.stringify(s)); } catch { /* fine */ }
    };

    let state = read();
    if (!state || typeof state !== 'object') state = { days: 0, lastDate: null, checked: [] };
    if (state.lastDate === today && Array.isArray(state.checked)) {
      boxes.forEach((b) => { b.checked = state.checked.includes(b.dataset.check); });
    }

    const refresh = (spoken = false) => {
      const checked = boxes.filter((b) => b.checked).map((b) => b.dataset.check);
      const first = cheer.hidden && checked.length > 0;
      cheer.hidden = checked.length === 0;
      if (spoken && first) announce(words(cheer));
      if (checked.length > 0 && state.lastDate !== today) {
        state.days = (state.days ?? 0) + 1;
        state.lastDate = today;
      }
      state.checked = checked;
      write(state);
      if ((state.days ?? 0) >= 2) {
        streakLine.hidden = false;
        streakEl.textContent = `You've shown grit on ${state.days} different days. Amazing!`;
      }
    };

    boxes.forEach((b) => b.addEventListener('change', () => {
      if (b.checked) burst(b.closest('.check-chip')!.querySelector('.coin')!, 8);
      refresh(true);
    }));
    refresh();
  }

</script>

<style>
  /* — the hero: words on the left, the art spot holding the door — */
  .intro {
    display: grid; gap: 28px; align-items: center;
  }
  .intro-copy { display: grid; gap: 18px; justify-items: start; }
  @media (min-width: 860px) {
    /* The painting was boxed at 460px beside a column of mostly empty
       blue — the best drawing on the page as the least of it. The words
       need about 46ch and no more, so the rest goes to the art. */
    .intro { grid-template-columns: minmax(0, 0.85fr) minmax(340px, 580px); }
  }
  .note { color: var(--gg-ink-soft); margin-top: 6px; }

  /* Setting `display` on a class silently defeats the UA's [hidden] rule —
     author styles always win — which is exactly how the old page ended up
     showing all fifteen cards at once. Every element this page both styles
     and hides gets its [hidden] put back. (The noscript reveal rules win
     over these on purpose: they're more specific.) */
  .scenario[hidden], .cheer[hidden], .trail[hidden], .finale[hidden],
  .yet-machine[hidden], .yet-list[hidden], .yet-word[hidden], .cab[hidden],
  .hud-tile[hidden], .ask-btn[hidden], .btn[hidden] { display: none; }

  /* The trailhead: Kim's painting at the exact 3:2 the spot always held.
     The words sit on the blank sign board in percentages of the painting,
     with cqw type so they hold at every width — the Erin School trick. */
  .trailhead { position: relative; container-type: inline-size; }
  .trailhead img {
    display: block; width: 100%; height: auto; image-rendering: pixelated;
    border-radius: var(--gg-radius); box-shadow: var(--gg-shadow);
  }
  .trailhead-sign {
    /* the board's pixels span 31–47% across and 63–70% down; the words sit
       on its plank part, just left of the arrow head */
    position: absolute; left: 38%; top: 66.5%; translate: -50% -50%;
    rotate: -2deg; /* the drawn board tips up toward the trail */
    font-family: var(--gg-display); font-weight: 600;
    font-size: 2.7cqw; line-height: 1; letter-spacing: 0.02em;
    color: #fff; white-space: nowrap;
    /* Same ink edge as the Erin School sign, and for the same reason:
       white on the painted board measured 2.67:1 at its worst and only
       3.98:1 on average, so the words never cleared AA against the wood
       they sit on. The outline does it without resizing the lettering,
       which is registered to the drawn board. */
    text-shadow:
      1px 0 0 var(--gg-ink), -1px 0 0 var(--gg-ink),
      0 1px 0 var(--gg-ink), 0 -1px 0 var(--gg-ink),
      1px 1px 0 var(--gg-ink), -1px -1px 0 var(--gg-ink),
      1px -1px 0 var(--gg-ink), -1px 1px 0 var(--gg-ink);
  }

  /* — the arcade: three cartridges, one machine —
     Everything from here down is drawn the way the trail's pixel art is
     drawn: an ink edge, flat fills, a hard offset shadow, and no blur or
     soft gradient anywhere. A card floats; a game piece sits. */
  .arcade { padding-block: 44px 64px; }
  .gz-tabs {
    display: flex; flex-wrap: wrap; gap: 14px; justify-content: center;
    margin-bottom: 30px;
  }
  .gz-tab {
    display: grid; justify-items: center; gap: 2px;
    min-width: 148px; min-height: var(--gg-tap); padding: 12px 20px;
    background: var(--gg-card); color: var(--gg-blue);
    border: 3px solid var(--gg-ink); border-radius: 12px;
    box-shadow: 4px 4px 0 var(--gg-ink);
    font-family: var(--gg-display); font-weight: 600; font-size: 1.02rem;
    cursor: pointer;
    transition: translate 0.12s ease, box-shadow 0.12s ease, background 0.12s ease;
  }
  .gz-tab .ico { display: grid; place-items: center; line-height: 0; }
  .gz-tab .ico img { width: 48px; height: 48px; image-rendering: pixelated; }
  .gz-tab:hover { translate: -1px -1px; box-shadow: 5px 5px 0 var(--gg-ink); }
  .gz-tab:active { translate: 3px 3px; box-shadow: 1px 1px 0 var(--gg-ink); }
  /* the chosen game is the cartridge pushed in: gold, ink-lettered (≈6:1),
     and sitting lower than its neighbours */
  .gz-tab[aria-selected='true'] {
    background: var(--gg-gold); color: var(--gg-ink);
    translate: 2px 2px; box-shadow: 2px 2px 0 var(--gg-ink);
  }
  .gz-panel { outline: none; }
  .gz-panel.enter { animation: panel-in 380ms var(--gg-ease-back); }
  @keyframes panel-in {
    from { opacity: 0; translate: 0 14px; scale: 0.99; }
    to { opacity: 1; translate: 0 0; scale: 1; }
  }
  .panel-head { max-width: 720px; margin: 0 auto 22px; text-align: center; }
  .panel-head .note { margin-inline: auto; }

  /* — the cabinet —
     One machine for every screen of a game: a deep-blue shell with an ink
     edge and a hard shadow, a HUD strip along the top, the screen inset
     behind its own bezel, and a control bar underneath where the buttons
     go. The map, each challenge, the cheer and the summit all wear it, so
     pressing Play changes what's on the screen, not where you are. */
  .cab {
    width: min(100%, 660px); margin-inline: auto;
    display: grid; gap: 10px; padding: 10px;
    background: var(--gg-blue-deep);
    border: 4px solid var(--gg-ink); border-radius: var(--gg-radius-small);
    box-shadow: 8px 8px 0 var(--gg-ink);
    /* the shell is dark, so its focus ring is white; the screen is light
       and puts the deep-blue ring back */
    --gg-focus: var(--gg-card);
  }
  .cab-screen {
    --gg-focus: var(--gg-blue-deep);
    position: relative; overflow: hidden;
    border: 3px solid var(--gg-ink); border-radius: 8px;
    background: var(--gg-px-sky);
  }
  /* the marquee: the title art sits centred on the shell above the HUD,
     the way a cabinet's lit header sits above its screen. The drawing
     carries transparent padding, so it is boxed by height and contained. */
  .cab-marquee { display: grid; place-items: center; padding: 6px 8px 0; }
  /* the title art is a wide banner, so it is sized by WIDTH — a height cap
     alone left it stranded in the middle of the shell. The max-height keeps
     a squarer drawing from towering over the screen. */
  .cab-marquee img {
    display: block; width: min(100%, 460px); height: auto; max-height: 150px;
    object-fit: contain; image-rendering: pixelated;
  }
  .cab-marquee.small img { width: min(100%, 340px); max-height: 110px; }
  /* a HUD left holding only its stop tile pushes it right, where it
     belongs; a HUD holding only a title keeps it on the left */
  .cab-hud:has(> .hud-tile:only-child) { justify-content: flex-end; }
  .cab-hud {
    display: flex; align-items: center; justify-content: space-between; gap: 10px;
    min-height: 36px; padding-inline: 2px;
    color: var(--gg-card);
    font-family: var(--gg-display); font-weight: 600;
    font-size: var(--gg-text-small); letter-spacing: 0.08em; text-transform: uppercase;
  }
  .hud-title { display: inline-flex; align-items: center; gap: 0.45em; line-height: 1; }
  .cab-bar {
    display: flex; flex-wrap: wrap; gap: 12px 16px;
    justify-content: center; align-items: center; padding: 4px 0 2px;
  }
  /* a bar with nothing showing on it folds away */
  .cab-bar:not(:has(> :not([hidden]))) { display: none; }

  /* the level tile: paper, an ink edge, a hard shadow. The number on a
     map stop, the "Stop 2" in a HUD, the A/B/C on a choice — one shape */
  .tile {
    display: inline-grid; place-items: center; line-height: 1;
    min-width: 1.6em; padding: 0.3em 0.55em 0.24em; text-align: center;
    background: var(--gg-card); color: var(--gg-ink);
    border: 2px solid var(--gg-ink); border-radius: 5px;
    box-shadow: 2px 2px 0 var(--gg-ink);
    font-family: var(--gg-display); font-weight: 700; font-size: var(--gg-text-small);
    letter-spacing: 0.04em;
  }
  .hud-tile { box-shadow: 2px 2px 0 var(--gg-px-rock); }

  /* the machine's buttons: square-shouldered, inked, and they press down */
  .cab-btn {
    font-size: 1.1rem;
    border: 3px solid var(--gg-ink); border-radius: 10px;
    box-shadow: 4px 4px 0 var(--gg-ink);
    transition: translate 0.1s ease, box-shadow 0.1s ease, background 0.15s ease;
  }
  .cab-btn:hover { transform: none; translate: -1px -1px; box-shadow: 5px 5px 0 var(--gg-ink); }
  .cab-btn:active { transform: none; translate: 3px 3px; box-shadow: 1px 1px 0 var(--gg-ink); }
  /* the quiet button on the dark shell wears white */
  .cab .btn-ghost { color: var(--gg-card); border-color: var(--gg-card); }
  .cab .btn-ghost:hover {
    color: var(--gg-card);
    background: color-mix(in srgb, var(--gg-card) 16%, transparent);
  }

  /* — the trail map: a 16-bit overworld on the cabinet's screen —
     The art underneath is a drop-in: the pixel set (PIXEL-PROMPTS.md)
     lands under the same file names. */
  .trail-scene { width: 100%; }
  .trail-art { display: block; width: 100%; height: auto; }
  /* the path is three strokes on one line: ink edge, sandy tread, and
     gold stepping-stones that march uphill (the map's idle shimmer) */
  .trail-under {
    fill: none; stroke: var(--gg-gold-ink); stroke-width: 30;
    stroke-linecap: round; stroke-linejoin: round;
