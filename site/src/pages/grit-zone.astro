  /* the stops: pebbles ahead, a glow where Gritty waits, stars that stay.
     Each state is a drawing on ::before (public/images/grit-zone/stop-*.webp);
     the button on top keeps the number and the words. --row counts
     switchbacks from the bottom, so the stops and their numbers grow as
     the trail climbs: the summit is the big one, and it looks it. */
  .stop {
    --row: 0;
    --size: calc(34px + var(--row) * 4px);
    position: absolute; translate: -50% -50%;
    display: grid; place-items: center;
    width: var(--size); height: var(--size); padding: 0;
    background: none; border: none; border-radius: 50%;
    isolation: isolate; /* keeps the ::before sprite behind the number, not behind the map */
    font-family: var(--gg-display); font-weight: 700;
    color: var(--gg-ink); font-size: calc(0.82rem + var(--row) * 0.12rem);
    transition: width 0.25s var(--gg-ease-back), height 0.25s var(--gg-ease-back);
  }
  /* Every drawing in this game is pixel art shown far smaller than the
     file it comes from — a 512px sprite in a 64px tile. Left alone the
     browser resamples it smoothly, which rounds the hard edges off and
     makes crisp pixel art look like a blurry drawing. `pixelated` keeps
     the squares square. Applied to every sprite on this page. */
  .stop::before {
    content: ''; position: absolute; inset: 0; z-index: -1;
    background: var(--stop-ahead) center / 100% 100% no-repeat;
    image-rendering: pixelated;
  }
  /* the number is a level tile */
  .stop .stop-num {
    position: relative; line-height: 1;
    min-width: 1.6em; padding: 0.16em 0.3em 0.1em; text-align: center;
    background: var(--gg-card); color: var(--gg-ink);
    border: 2px solid var(--gg-ink); border-radius: 5px;
    box-shadow: 2px 2px 0 var(--gg-ink);
