  .stop:disabled { cursor: default; }
  .stop.done { --size: calc(48px + var(--row) * 4px); cursor: pointer; }
  .stop.done::before { background-image: var(--stop-done); }
  .stop.done .stop-num { display: none; }
  .stop.done:hover { scale: 1.12; }
  .stop.current {
    --size: calc(64px + var(--row) * 5px);
    cursor: pointer; z-index: 2;
    font-size: calc(1.2rem + var(--row) * 0.12rem);
  }
  /* the glowing stop's tile goes gold — ink on gold, ≈6:1 */
  .stop.current .stop-num {
    background: var(--gg-gold); box-shadow: 3px 3px 0 var(--gg-ink);
  }
  .stop.current::before { background-image: var(--stop-current); }
  @media (prefers-reduced-motion: no-preference) {
    .stop.current::before { animation: stop-pulse 1.6s ease-in-out infinite; }
  }
  @keyframes stop-pulse {
    0%, 100% { scale: 1; }
    50% { scale: 1.14; }
  }
  .stop.just::before { animation: star-in 650ms var(--gg-ease-bouncy); }
  @keyframes star-in { from { scale: 0; rotate: -40deg; } to { scale: 1; rotate: 0deg; } }

  /* Gritty on the map: he stands just above the stop he's thinking about */
  .walker {
    position: absolute; z-index: 3; pointer-events: none;
    translate: -50% -128%;
    transition: left 900ms var(--gg-ease-bouncy), top 900ms var(--gg-ease-bouncy);
  }
  /* a portrait tile, not a bubble: ink frame, sky behind, hard shadow.
     The dialog box on the challenge screen uses the very same tile. */
  .walker img, .face {
