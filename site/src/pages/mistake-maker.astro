---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Bubble from '../components/Bubble.astro';
import Stamp from '../components/Stamp.astro';
import Icon from '../components/Icon.astro';
import { u } from '../lib/url';

const mistakes = (await getCollection('mistakes')).sort((a, b) => a.data.order - b.data.order);
const FALLBACK_LEARNED = 'Mistakes help my brain learn!';
---

<Base
  title="The Mistake Maker — Growing with Gritty"
  description="Press the button for one of Gritty the Goat's funny mistakes — then turn his OOPS into I LEARNED! Mistakes are how brains grow."
>
  <section class="band">
    <div class="wrap intro-grid">
      <div class="intro">
        <p class="eyebrow">Gritty's World</p>
        <h1>The Mistake Maker <Icon name="action-brain-grows" size="1.1em" /></h1>
        <Bubble side="right">
          "Everyone makes mistakes — even me! Mistakes don't mean I'm bad at
          something. Mistakes help my brain learn!"
        </Bubble>
      </div>
      <img
        class="intro-art"
        src={u("/images/characters/gritty-standing.webp")}
        alt="Gritty the Goat, hand-drawn by Kim Rekowski"
        width="878" height="1097"
      />
    </div>
  </section>

  <section class="band band-sky" aria-labelledby="machine-h">
    <div class="wrap machine-wrap">
      <h2 id="machine-h">Ready for a silly one?</h2>
      <p class="note">Press the button to hear one of Gritty's mistakes —
      then flip it into something he learned.</p>

      {/* Without JavaScript, the whole collection reads as a friendly list —
          each oops with its lesson right underneath. */}
      <div class="mistake-list" data-mistake-static>
        {mistakes.map((m) => (
          <article
            class="mistake card"
            data-oops={m.data.oops}
            data-learned={m.data.learned ?? FALLBACK_LEARNED}
          >
            <p class="oops-line"><Icon name="feeling-silly-oops" /> {m.data.oops}</p>
            <p class="learned-line"><Icon name="action-idea" /> {m.data.learned ?? FALLBACK_LEARNED}</p>
          </article>
        ))}
      </div>

      <div class="machine card" data-machine hidden>
        <button type="button" class="btn btn-primary big-btn" data-make>
          <Icon name="feeling-silly-oops" /> Oops! I made a mistake!
        </button>
        <div class="stage" data-stage hidden>
          <p class="oops-line"><Icon name="feeling-silly-oops"
            /><span data-stage-oops></span></p>
          <button type="button" class="btn btn-gold big-btn" data-turn>
            <Icon name="action-try-again" /> Turn my OOPS into I LEARNED!
          </button>
          <p class="learned-line" hidden data-stage-learned-line><Icon name="action-idea" /> <span
            data-stage-learned></span></p>
          <button type="button" class="btn btn-ghost" data-again hidden>
            <Icon name="feeling-silly-oops" /> Another mistake, please!
          </button>
        </div>
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="moves-h">
    <div class="wrap moves-wrap">
      <h2 id="moves-h">Gritty's four moves</h2>
      <p class="note">When a mistake happens, a goat with grit can always
      pick one of these.</p>
      <div class="moves">
        <Stamp icon="action-try-again" label="Try Again" tone="blue" tilt={-3} />
        <Stamp icon="action-idea" label="Learn From It" tone="gold" tilt={2} />
        <Stamp icon="action-ask-for-help" label="Ask for Help" tone="green" tilt={-2} />
        <Stamp icon="action-calm-break" label="Take a Break" tone="blue" tilt={3} />
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap next-up card">
      <p>Sometimes a mistake brings a big feeling with it. That's okay too.</p>
      <a class="btn btn-primary" href={u('/calming-corner')}><Icon name="action-calm-break" /> Visit the Calming Corner</a>
    </div>
  </section>
</Base>

<script>
  import { announce } from '../lib/announce';

  const staticList = document.querySelector<HTMLElement>('[data-mistake-static]');
  const machine = document.querySelector<HTMLElement>('[data-machine]');
  if (staticList && machine) {
    const entries = [...staticList.querySelectorAll<HTMLElement>('[data-oops]')]
      .map((el) => ({ oops: el.dataset.oops ?? '', learned: el.dataset.learned ?? '' }));

    if (entries.length > 0) {
      staticList.hidden = true;
      machine.hidden = false;

      const makeBtn = machine.querySelector<HTMLElement>('[data-make]')!;
      const stage = machine.querySelector<HTMLElement>('[data-stage]')!;
      const oopsEl = machine.querySelector<HTMLElement>('[data-stage-oops]')!;
      const learnedLine = machine.querySelector<HTMLElement>('[data-stage-learned-line]')!;
      const turnBtn = machine.querySelector<HTMLElement>('[data-turn]')!;
      const learnedEl = machine.querySelector<HTMLElement>('[data-stage-learned]')!;
      const againBtn = machine.querySelector<HTMLElement>('[data-again]')!;

      /* Start somewhere different each visit, then cycle in order. */
      let i = Math.floor(Math.random() * entries.length);

      const showOops = () => {
        stage.hidden = false;
        oopsEl.textContent = entries[i].oops;
        learnedLine.hidden = true;
        againBtn.hidden = true;
        turnBtn.hidden = false;
        /* the stage was hidden a moment ago, so a live role on the line
           itself would stay silent — the page's announcer says it instead */
        announce(`Oops! ${entries[i].oops}`);
      };

      makeBtn.addEventListener('click', () => {
        makeBtn.hidden = true;
        showOops();
        turnBtn.focus();
      });

      turnBtn.addEventListener('click', () => {
        turnBtn.hidden = true;
        learnedEl.textContent = `I learned: ${entries[i].learned}`;
        learnedLine.hidden = false;
        againBtn.hidden = false;
        announce(`I learned: ${entries[i].learned}`);
        againBtn.focus();
      });

      againBtn.addEventListener('click', () => {
        i = (i + 1) % entries.length;
        showOops();
        turnBtn.focus();
      });
    }
  }
</script>

<style>
  .intro { display: grid; gap: 18px; justify-items: start; }
  /* Gritty stands to the right of his words, so the bubble's tail climbs
     off the upper-right corner toward his mouth — the same hero shape as
     Meet Gritty. */
  .intro-grid {
    display: grid; grid-template-columns: auto minmax(220px, 320px);
    gap: 24px 48px; align-items: center; justify-content: start;
  }
  .intro-art { width: 100%; max-width: 320px; height: auto; }
  /* Phones: Gritty moves above the words rather than squeezing them into a
     sliver, and the bubble drops its tail — there's no goat beside it now. */
  @media (max-width: 820px) {
    .intro-grid { grid-template-columns: 1fr; justify-items: center; gap: 20px; }
    .intro-art { max-width: 240px; order: -1; }
    .intro { justify-items: center; text-align: center; }
    .intro :global(.bubble)::before,
    .intro :global(.bubble)::after { display: none; }
  }
  .note { color: var(--gg-ink-soft); margin-top: 6px; }

  .machine-wrap { display: grid; justify-items: start; }
  .mistake-list { margin-top: 24px; display: grid; gap: 16px; max-width: 680px; }
  .mistake { padding: 26px 28px; display: grid; gap: 12px; }

  .machine {
    margin-top: 24px; padding: 40px 32px; width: min(100%, 680px);
    display: grid; gap: 20px; justify-items: center; text-align: center;
  }
  /* A class's display beats [hidden]'s, so every element this page hides
     has to say so itself — otherwise the no-JS list, the stage, and the
     "Another mistake" button all sit on screen from the first paint. */
  .stage { display: grid; gap: 18px; justify-items: center; }
  .stage[hidden], .mistake-list[hidden], .machine [hidden] { display: none; }
  .big-btn { font-size: 1.2rem; }

  .oops-line {
    font-family: var(--gg-hand); font-size: clamp(1.4rem, 3.5vw, 1.8rem);
    line-height: 1.35;
  }
  .learned-line {
    font-weight: 700; color: var(--gg-gold-ink);
    background: #FFFDF4; border: 3px solid var(--gg-gold);
    border-radius: var(--gg-radius-small); padding: 14px 18px;
    max-width: 48ch;
  }

  .moves-wrap { display: grid; gap: 8px; }
  .moves {
    margin-top: 20px; display: flex; flex-wrap: wrap;
    gap: 24px 40px; justify-content: center;
  }

  .next-up {
    display: flex; flex-wrap: wrap; align-items: center; gap: 16px 32px;
    padding: 28px 36px;
  }
  .next-up p { flex: 1; min-width: 240px; }
  .next-up .btn { flex: none; }
</style>
