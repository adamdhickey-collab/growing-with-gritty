---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Bubble from '../../components/Bubble.astro';
import { u } from '../../lib/url';
import { buyLabel } from '../../lib/buy';
import IconCart from '../../components/IconCart.astro';
import Icon from '../../components/Icon.astro';

export async function getStaticPaths() {
  const books = await getCollection('books');
  return books.map((book) => ({ params: { id: book.id }, props: { book } }));
}

const { book } = Astro.props;
const { Content } = await render(book);
const { title, order, cover, ages, lesson, buyLink, challenge, activitySheet, spreads } = book.data;

/* Characters featured in this book, in series order. Missing ids are
   skipped rather than crashing — the CMS can't guarantee referential
   integrity and a typo must never take the site down. */
const characters = (
  await Promise.all(book.data.characters.map((id) => getEntry('characters', id)))
).filter((c) => c !== undefined).sort((a, b) => a.data.order - b.data.order);

const sheet = activitySheet ? await getEntry('printables', activitySheet) : undefined;
---

<Base
  title={`${title} — Growing with Gritty`}
  description={`${title}, book ${order} in the Gritty the Goat series by Kim Rekowski.`}
>
  <article>
    <section class="band">
      <div class="wrap head-grid">
        <div class="cover card">
          <img src={u(cover)} alt={`${title} book cover`} width="322" height="322" />
        </div>
        <div class="head-copy">
          <p class="eyebrow">Book {order} in the series{ages && ` · Ages ${ages}`}</p>
          <h1>{title}</h1>
          <div class="story flow"><Content /></div>
          <div class="actions">
            {buyLink && (
              <a class="btn btn-gold" href={buyLink} target="_blank" rel="noopener"
                 aria-label={`${buyLabel(buyLink)}: ${title} (opens in a new tab)`}>
                <IconCart />{buyLabel(buyLink)}
              </a>
            )}
            {sheet && <a class="btn btn-ghost" href={u(sheet.data.download)}><Icon name="printable-coloring-page" /> Activity sheet</a>}
            {!buyLink && <p class="soon">Buy link coming soon — ask at your favorite bookstore!</p>}
          </div>
        </div>
      </div>
    </section>

    {spreads.length > 0 && (
      <section class="band" id="inside" aria-labelledby="inside-h">
        <div class="wrap">
          <h2 id="inside-h"><Icon name="ui-look-inside" /> Look inside</h2>
          <p class="inside-note">Swipe or scroll through a few real pages
          from the book.</p>
          {/* A sideways scroller needs to be focusable, or a keyboard can't
              reach the pages past the first — hence tabindex and a name. */}
          <ol class="spreads" role="list" tabindex="0"
              aria-label={`Pages from inside ${title} — scroll sideways to see more`}>
            {spreads.map((src, i) => (
              <li>
                <img src={u(src)} alt={`${title} — inside pages, spread ${i + 1} of ${spreads.length}`}
                     width="1369" height="690" loading="lazy" />
              </li>
            ))}
          </ol>
          {/* Arrows and a "1 of 3" for anyone who doesn't spot the scrollbar.
              JS-only controls, so they arrive hidden and the script shows them. */}
          <div class="spreads-nav" data-spreads-nav hidden>
            <button type="button" class="spreads-btn" data-spreads-prev
                    aria-label="Previous pages"><Icon name="ui-back" size="1.5em" /></button>
            <span class="spreads-pos" data-spreads-pos aria-live="polite"></span>
            <button type="button" class="spreads-btn" data-spreads-next
                    aria-label="Next pages"><Icon name="ui-next-arrow" size="1.5em" /></button>
          </div>
          {buyLink && (
            <p class="inside-buy">
              <a class="btn btn-gold" href={buyLink} target="_blank" rel="noopener"
                 aria-label={`Order ${title} — ${buyLabel(buyLink)} (opens in a new tab)`}>
                <IconCart />Order {title}
              </a>
            </p>
          )}
        </div>
      </section>
    )}

    {lesson && (
      <section class="band band-sky">
        <div class="wrap">
          <h2>What did Gritty learn?</h2>
          <p class="lesson">{lesson}</p>
        </div>
      </section>
    )}

    {characters.length > 0 && (
      <section class="band">
        <div class="wrap">
          <h2>Who's in this story?</h2>
          <ul class="char-row" role="list">
            {characters.map((c) => (
              <li>
                <a class="char-chip" href={u("/meet-gritty")}>
                  {c.data.portrait
                    ? <img src={u(c.data.portrait)} alt="" width="56" height="72" loading="lazy" />
                    : <span class="chip-emoji" aria-hidden="true"><Icon name="character-coming" size="2.2rem" /></span>}
                  {c.data.name}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    {challenge && (
      <section class="band">
        <div class="wrap challenge">
          <h2 class="visually-hidden">Grit challenge</h2>
          <p class="eyebrow gritty-eyebrow">
            <img src={u("/images/gritty/gritty-face.webp")} alt="" width="160" height="160" />
            Grit challenge — talk about it together
          </p>
          <Bubble tail={false}>{challenge}</Bubble>
        </div>
      </section>
    )}
  </article>
</Base>

<script>
  /* The look-inside strip: arrows step one spread at a time and the
     counter follows the scroll, whichever way the reader moves it. */
  const strip = document.querySelector<HTMLElement>('.spreads');
  const nav = document.querySelector<HTMLElement>('[data-spreads-nav]');
  if (strip && nav) {
    const items = [...strip.querySelectorAll<HTMLElement>('li')];
    const prev = nav.querySelector<HTMLButtonElement>('[data-spreads-prev]')!;
    const next = nav.querySelector<HTMLButtonElement>('[data-spreads-next]')!;
    const pos = nav.querySelector<HTMLElement>('[data-spreads-pos]')!;
    const calm = () => matchMedia('(prefers-reduced-motion: reduce)').matches
      || document.documentElement.dataset.motion === 'calm';
    /* where a spread's centre sits in the strip's scroll space */
    const centre = (li: HTMLElement) =>
      li.getBoundingClientRect().left - strip.getBoundingClientRect().left
      + strip.scrollLeft + li.offsetWidth / 2;
    const index = () => {
      const mid = strip.scrollLeft + strip.clientWidth / 2;
      let best = 0, gap = Infinity;
      items.forEach((li, i) => {
        const d = Math.abs(centre(li) - mid);
        if (d < gap) { gap = d; best = i; }
      });
      return best;
    };
    const go = (i: number) => {
      const li = items[Math.max(0, Math.min(items.length - 1, i))];
      strip.scrollTo({ left: centre(li) - strip.clientWidth / 2, behavior: calm() ? 'auto' : 'smooth' });
    };
    const update = () => {
      const i = index();
      prev.disabled = i === 0;
      next.disabled = i === items.length - 1;
      pos.textContent = `${i + 1} of ${items.length}`;
    };
    prev.addEventListener('click', () => go(index() - 1));
    next.addEventListener('click', () => go(index() + 1));
    strip.addEventListener('scroll', update, { passive: true });
    addEventListener('resize', update);
    nav.hidden = items.length < 2;
    update();
  }
</script>

<style>
  /* Gritty's own face fronting the grit challenge — his art, not an icon */
  .gritty-eyebrow { display: flex; align-items: center; gap: 0.45em; }
  /* the scan's paper edge disappears once it's a round badge */
  .gritty-eyebrow img { width: 1.9em; height: 1.9em; border-radius: 50%; }

  .head-grid {
    display: grid; grid-template-columns: minmax(220px, 340px) 1fr;
    gap: 32px 56px; align-items: start;
  }
  .cover { padding: 16px; }
  .cover img { display: block; width: 100%; border-radius: var(--gg-radius-small); }
  .head-copy { display: grid; gap: 16px; justify-items: start; }
  .story { color: var(--gg-ink); }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 14px; }
  .soon { font-size: var(--gg-text-small); color: var(--gg-ink-soft); }

  /* — look inside — */
  .inside-note { color: var(--gg-ink-soft); margin-top: 6px; }
  .spreads {
    list-style: none; margin-top: 20px;
    /* each spread nearly fills the strip so the book's own lettering can
       be read; a sliver of the next one peeks in as the second hint */
    display: grid; grid-auto-flow: column; grid-auto-columns: min(94%, 1000px);
    gap: 18px; overflow-x: auto; overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory; padding-bottom: 14px;
  }
  /* The scrollbar is the hint that there's more: always shown, in the
     site's colours, even where the OS hides bars until the first swipe.
     WebKit/Blink get the drawn bar; Firefox gets the standard properties
     (setting those in Blink would switch its overlay bar back on). */
  @supports not selector(::-webkit-scrollbar) {
    .spreads { scrollbar-width: auto; scrollbar-color: var(--gg-blue) var(--gg-sky); }
  }
  .spreads::-webkit-scrollbar { height: 12px; }
  .spreads::-webkit-scrollbar-track { background: var(--gg-sky); border-radius: 999px; }
  .spreads::-webkit-scrollbar-thumb {
    background: var(--gg-blue); border-radius: 999px;
    border: 2px solid var(--gg-sky);
  }
  .spreads::-webkit-scrollbar-thumb:hover { background: var(--gg-blue-deep); }
  .spreads li { scroll-snap-align: center; }
  .spreads-nav { display: flex; align-items: center; gap: 14px; margin-top: 14px; }
  .spreads-nav[hidden] { display: none; }
  .spreads-btn {
    width: var(--gg-tap); height: var(--gg-tap); border-radius: 50%;
    display: grid; place-items: center; line-height: 0;
    background: #fff; color: var(--gg-blue);
    border: 2.5px solid var(--gg-blue); cursor: pointer;
    transition: background 0.15s ease, translate 0.15s ease, opacity 0.15s ease;
  }
  .spreads-btn:hover:not(:disabled) {
    background: color-mix(in srgb, var(--gg-sky) 45%, #fff); translate: 0 -2px;
  }
  .spreads-btn:active:not(:disabled) { scale: 0.95; }
  .spreads-btn:disabled { opacity: 0.35; cursor: default; }
  .spreads-pos {
    font-family: var(--gg-display); font-weight: 600;
    font-size: var(--gg-text-small); color: var(--gg-ink-soft);
    min-width: 5ch; text-align: center;
  }
  .spreads img {
    width: 100%; height: auto; display: block;
    border-radius: var(--gg-radius-small);
    border: 3px solid #fff; box-shadow: var(--gg-shadow);
    background: #fff;
  }
  .inside-buy { margin-top: 20px; }

  .lesson {
    margin-top: 12px; font-family: var(--gg-display); font-weight: 500;
    font-size: 1.3rem; color: var(--gg-green-ink); max-width: 46ch;
  }

  .char-row { list-style: none; display: flex; flex-wrap: wrap; gap: 14px; margin-top: 18px; }
  .char-chip {
    display: inline-flex; align-items: center; gap: 10px;
    background: #fff; border: 2px solid color-mix(in srgb, var(--gg-blue) 25%, transparent);
    border-radius: 999px; padding: 8px 18px 8px 10px; min-height: var(--gg-tap);
    font-family: var(--gg-display); font-weight: 500; text-decoration: none;
  }
  .char-chip:hover { border-color: var(--gg-blue); }
  .char-chip img { width: 40px; height: 52px; object-fit: contain; }
  .chip-emoji { font-size: 1.5rem; }

  .challenge { display: grid; gap: 14px; justify-items: start; }

  @media (max-width: 720px) {
    .head-grid { grid-template-columns: 1fr; }
    .cover { max-width: 300px; }
  }
</style>
